---
export interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "accent" | "outline" | "gold";
  size?: "sm" | "md" | "lg";
  class?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  target,
  rel,
  disabled = false,
  type = "button",
  ariaLabel,
  ...rest
} = Astro.props;

const baseStyles = [
  "inline-flex items-center justify-center gap-2",
  "font-sans text-sm sm:text-base font-semibold",
  "border rounded-lg",
  "transition-all duration-200 ease-in-out",
  "focus:outline-none focus:ring-2 focus:ring-offset-2",
  "disabled:opacity-50 disabled:cursor-not-allowed",
  "min-h-[44px]",
  "shadow-sm",
];

const sizeStyles = {
  sm: "px-3.5 py-1.5 text-xs sm:text-sm",
  md: "px-5 py-2.5 text-sm sm:text-base",
  lg: "px-7 py-3.5 text-base sm:text-lg",
};

const variantStyles = {
  primary: [
    "bg-gradient-to-r from-amber-500 via-amber-600 to-amber-700 text-stone-950 border-amber-500 font-bold",
    "hover:from-amber-600 hover:to-amber-800 hover:text-white hover:border-amber-600",
    "focus:ring-amber-500 shadow-amber-500/20 shadow-md",
  ],
  secondary: [
    "bg-gradient-to-r from-red-800 to-stone-900 text-white border-red-800",
    "hover:from-red-900 hover:to-stone-950 hover:border-red-900",
    "focus:ring-red-600 shadow-md",
  ],
  accent: [
    "bg-gradient-to-r from-orange-600 to-amber-600 text-white border-orange-600",
    "hover:from-orange-700 hover:to-amber-700 hover:border-orange-700",
    "focus:ring-orange-500 shadow-md",
  ],
  outline: [
    "bg-white/90 text-stone-800 border-stone-300",
    "hover:bg-amber-50 hover:border-amber-500 hover:text-amber-800",
    "focus:ring-amber-500",
  ],
  gold: [
    "bg-amber-400 text-stone-950 border-amber-300 font-bold shadow-md",
    "hover:bg-amber-300 hover:shadow-lg",
    "focus:ring-amber-400",
  ],
};

const classes = [
  ...baseStyles,
  sizeStyles[size],
  ...variantStyles[variant],
  className,
].join(" ");
---

{
  href ? (
    <a
      href={href}
      class={classes}
      target={target}
      rel={rel}
      aria-label={ariaLabel}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={classes}
      disabled={disabled}
      aria-label={ariaLabel}
      {...rest}
    >
      <slot />
    </button>
  )
}
