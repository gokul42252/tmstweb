---
import Navigation from "./Navigation.astro";
---

<header class="sticky top-0 z-50 w-full bg-white shadow-sm border-b" style="border-bottom-color: var(--theme-card-border, rgba(0,0,0,0.08));">
  <!-- Tier 1: Main Brand & Action Strip -->
  <div class="bg-white border-b border-stone-100">
    <div class="container flex items-center justify-between py-2 sm:py-3">
      <!-- Temple Logo & Titles -->
      <a href="/" class="flex items-center space-x-2.5 sm:space-x-3.5 group text-left flex-1 min-w-0 pr-2">
        <!-- Sacred Emblem Badge -->
        <div
          class="w-10 h-10 xs:w-12 xs:h-12 sm:w-14 sm:h-14 rounded-full p-0.5 shadow-md flex-shrink-0 group-hover:scale-105 transition-transform"
          style="background: linear-gradient(135deg, var(--theme-gradient-start), var(--theme-gradient-mid), var(--theme-gradient-end));"
        >
          <div class="w-full h-full rounded-full bg-stone-950 flex items-center justify-center p-1.5 sm:p-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class="w-full h-full" style="color: var(--theme-primary-light, #fbbf24);">
              <path d="M50 15 L50 78 M42 22 C36 28 35 40 43 46 M58 22 C64 28 65 40 57 46 M43 46 C48 48 52 48 57 46" stroke="currentColor" stroke-width="5" stroke-linecap="round" fill="none" />
              <circle cx="50" cy="56" r="3.5" fill="#dc2626" />
              <path d="M35 84 Q50 78 65 84 L60 88 L40 88 Z" fill="currentColor" />
            </svg>
          </div>
        </div>

        <div class="min-w-0 flex-1">
          <div class="font-malayalam font-bold text-xs xs:text-sm sm:text-base md:text-lg lg:text-xl leading-tight tracking-wide truncate" style="color: var(--theme-primary-dark, #1c1917);">
            തിരുമാറാടി ശ്രീ മഹാദേവ ക്ഷേത്രം
          </div>
          <div class="font-serif font-bold text-stone-800 text-[10px] xs:text-xs sm:text-sm lg:text-[15px] tracking-wider uppercase leading-tight truncate">
            Thirumarady Sri Mahadeva Temple
          </div>
          <div class="text-[9px] xs:text-[10px] sm:text-xs text-stone-500 flex items-center space-x-1 sm:space-x-1.5 mt-0.5 truncate">
            <span class="font-semibold truncate" style="color: var(--theme-primary, #b45309);">ക്ഷേത്ര ഭരണ സമിതി</span>
            <span>•</span>
            <span class="truncate">Piravom, Ernakulam</span>
            <span class="hidden md:inline">•</span>
            <span class="hidden md:inline">PIN: 686662</span>
          </div>
        </div>
      </a>

      <!-- Right Side Utilities & CTAs -->
      <div class="flex items-center space-x-1.5 sm:space-x-2.5 flex-shrink-0">
        <!-- Direct Quick Link to Darshan Timings (Desktop) -->
        <a
          href="/darshan-timings"
          class="hidden md:inline-flex items-center space-x-1.5 px-3 py-2 text-xs font-semibold rounded-lg text-stone-700 hover:text-stone-900 bg-stone-50 hover:bg-stone-100 border border-stone-200 transition-colors whitespace-nowrap"
        >
          <span style="color: var(--theme-primary);">🕒</span>
          <span>Darshan Schedule</span>
        </a>

        <!-- Quick Theme Picker Button in Header -->
        <button
          type="button"
          onclick="window.openThemeModal ? window.openThemeModal() : null"
          class="inline-flex items-center space-x-1 px-2.5 sm:px-3 py-1.5 sm:py-2 text-xs font-semibold rounded-lg text-stone-700 hover:text-stone-900 bg-stone-100/90 hover:bg-stone-200/90 border border-stone-200 transition-all whitespace-nowrap"
          title="Change between 6 Sacred Temple Themes"
          aria-label="Change Theme"
        >
          <span>🎨</span>
          <span class="hidden sm:inline">Theme</span>
        </button>

        <!-- Direct Online Vazhipadu Button -->
        <a
          href="/vazhipadu#booking"
          class="btn-primary inline-flex items-center px-2.5 xs:px-3 sm:px-4 py-1.5 sm:py-2 text-[11px] sm:text-xs uppercase tracking-wider font-bold rounded-xl transition-all whitespace-nowrap"
        >
          <span class="mr-1">🪔</span>
          <span class="hidden xs:inline">Online </span><span>Booking</span>
        </a>

        <!-- Mobile Menu Hamburger Button (Screens < lg) -->
        <button
          id="mobile-menu-button"
          class="lg:hidden p-1.5 sm:p-2 text-stone-700 hover:text-stone-900 hover:bg-stone-100 rounded-xl focus:outline-none transition-colors border border-stone-200"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Tier 2: Dedicated Navigation Strip (Desktop) + Mobile Drawer -->
  <Navigation />
</header>
