---
// Define the navigation items
const navItems = [
  { text: "Home", malayalam: "മുഖ്യം", href: "/" },
  { text: "Darshan & Timings", malayalam: "ദർശനം", href: "/darshan-timings" },
  { text: "Vazhipadu", malayalam: "വഴിപാടുകൾ", href: "/vazhipadu" },
  { text: "Festivals", malayalam: "ഉത്സവങ്ങൾ", href: "/festivals" },
  { text: "Heritage", malayalam: "ഐതിഹ്യം", href: "/heritage" },
  { text: "Deities", malayalam: "പ്രതിഷ്ഠകൾ", href: "/deities" },
  { text: "Gallery", malayalam: "ചിത്രശാല", href: "/gallery" },
  { text: "Donations", malayalam: "സംഭാവന", href: "/administration" },
  { text: "How to Reach", malayalam: "വഴികാട്ടി", href: "/how-to-reach" },
  { text: "Themes", malayalam: "വർണ്ണങ്ങൾ", href: "/themes" },
];

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.replace(/\/index\.html$/, "").replace(/\/$/, "") || "/";
---

<!-- Desktop Tier 2 Navigation Bar (Visible on lg and above) -->
<nav class="hidden lg:block bg-stone-950 border-t text-stone-200 shadow-md select-none" style="border-top-color: var(--theme-card-border, rgba(255,255,255,0.15));" aria-label="Main Navigation">
  <div class="container mx-auto px-2 sm:px-4">
    <ul class="flex items-center justify-between gap-1 py-1 sm:py-1.5">
      {
        navItems.map((item) => {
          const normalizedHref = item.href.replace(/\/$/, "") || "/";
          const isActive = normalizedPath === normalizedHref || 
                           (normalizedHref !== "/" && normalizedPath.startsWith(normalizedHref));
          
          return (
            <li class="flex-1 text-center">
              <a
                href={item.href}
                class={`w-full py-1.5 px-1.5 lg:px-2 xl:px-2.5 rounded-lg transition-all duration-150 flex flex-col items-center justify-center whitespace-nowrap group ${
                  isActive 
                    ? "font-bold shadow-sm" 
                    : "text-stone-300 hover:text-white hover:bg-stone-900/90 font-medium"
                }`}
                style={isActive ? "background-color: var(--theme-primary); color: #ffffff;" : undefined}
                aria-current={isActive ? "page" : undefined}
              >
                <span class="text-[11px] xl:text-[13px] tracking-wide leading-tight">
                  {item.text}
                </span>
                <span class={`text-[9px] xl:text-[10px] font-malayalam leading-tight mt-0.5 ${
                  isActive ? "text-white font-semibold opacity-90" : "text-stone-400 group-hover:text-stone-200"
                }`}>
                  {item.malayalam}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>

<!-- Mobile & Tablet Menu Dropdown Drawer (Visible on screens < lg) -->
<div
  id="mobile-menu"
  class="absolute top-full left-0 right-0 w-full bg-white shadow-2xl border-t-2 hidden lg:hidden z-50 max-h-[85vh] overflow-y-auto"
  style="border-top-color: var(--theme-primary, #09979D);"
  role="menu"
  aria-labelledby="mobile-menu-button"
>
  <div class="p-3 sm:p-4 bg-stone-50 border-b border-stone-200 flex items-center justify-between gap-2">
    <div class="min-w-0">
      <span class="text-xs sm:text-sm font-bold text-stone-900 block font-malayalam truncate">തിരുമാറാടി ശ്രീ മഹാദേവ ക്ഷേത്രം</span>
      <span class="text-[10px] sm:text-[11px] text-stone-600 block">Daily Darshan: 5:00–10:30 AM & 5:00–8:00 PM</span>
    </div>
    <a href="tel:+914852877300" class="text-xs font-bold text-stone-900 bg-white px-2.5 py-1 rounded-md border border-stone-300 shadow-xs flex items-center space-x-1 flex-shrink-0">
      <span>📞</span>
      <span>0485-2877300</span>
    </a>
  </div>

  <div class="p-3 sm:p-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2 sm:gap-2.5">
    {
      navItems.map((item) => {
        const normalizedHref = item.href.replace(/\/$/, "") || "/";
        const isActive = normalizedPath === normalizedHref || 
                         (normalizedHref !== "/" && normalizedPath.startsWith(normalizedHref));
        
        return (
          <a
            href={item.href}
            class={`p-2.5 sm:p-3 text-xs sm:text-sm rounded-xl transition-colors flex flex-col justify-center min-h-[54px] sm:min-h-[60px] ${
              isActive 
                ? "font-bold text-white shadow-sm" 
                : "text-stone-700 hover:bg-stone-50 border border-stone-100 font-medium"
            }`}
            style={isActive ? "background-color: var(--theme-primary); color: #ffffff;" : undefined}
            role="menuitem"
          >
            <span class="leading-tight">{item.text}</span>
            <span class={`text-[11px] sm:text-xs font-malayalam font-normal mt-0.5 ${isActive ? "text-white/80" : "text-stone-500"}`}>{item.malayalam}</span>
          </a>
        );
      })
    }
  </div>

  <div class="p-3 sm:p-4 bg-stone-50 border-t border-stone-200 flex flex-col sm:flex-row gap-2 sm:gap-3">
    <button
      type="button"
      onclick="window.openThemeModal ? window.openThemeModal() : null"
      class="flex-1 text-center py-2.5 sm:py-3 text-xs sm:text-sm font-bold rounded-xl text-stone-800 bg-white border border-stone-300 shadow-sm flex items-center justify-center space-x-2"
    >
      <span>🎨</span>
      <span>Choose from 6 Sacred Themes</span>
    </button>
    <a
      href="/vazhipadu#booking"
      class="btn-primary flex-1 text-center py-2.5 sm:py-3 text-xs sm:text-sm font-bold rounded-xl shadow-sm"
    >
      🪔 Online Vazhipadu Booking
    </a>
  </div>
</div>

<script>
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuIconOpen = document.getElementById("menu-icon-open");
  const menuIconClose = document.getElementById("menu-icon-close");

  if (mobileMenuButton && mobileMenu && menuIconOpen && menuIconClose) {
    function toggleMenu() {
      const isExpanded = mobileMenuButton.getAttribute("aria-expanded") === "true";
      mobileMenuButton.setAttribute("aria-expanded", (!isExpanded).toString());
      mobileMenu.classList.toggle("hidden");
      menuIconOpen.classList.toggle("hidden");
      menuIconClose.classList.toggle("hidden");
    }

    mobileMenuButton.addEventListener("click", toggleMenu);

    // Close mobile menu on resize to desktop
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024 && !mobileMenu.classList.contains("hidden")) {
        mobileMenu.classList.add("hidden");
        mobileMenuButton.setAttribute("aria-expanded", "false");
        menuIconOpen.classList.remove("hidden");
        menuIconClose.classList.add("hidden");
      }
    });
  }
</script>
