---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  staff: CollectionEntry<'staff'>;
  className?: string;
}

const { staff, className = '' } = Astro.props;
---

<div class:list={['bg-white rounded-2xl border border-stone-200 shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col h-full group', className]}>
  <!-- Photo -->
  <div class="relative w-full aspect-square bg-stone-900 overflow-hidden">
    <img
      src={staff.data.image || "/uploads/temple/hero-temple.jpg"}
      alt={staff.data.name}
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
    />
  </div>

  <div class="p-6 flex flex-col flex-1 justify-between">
    <div>
      <span class="text-xs uppercase font-bold text-amber-700 tracking-wider block mb-1">
        {staff.data.title}
      </span>
      <h3 class="text-xl font-serif font-bold text-stone-900 mb-2">
        {staff.data.name}
      </h3>
      <p class="text-stone-600 text-xs sm:text-sm leading-relaxed mb-4">
        {staff.data.bio}
      </p>
    </div>

    <div class="pt-4 border-t border-stone-100 space-y-1.5 text-xs">
      {staff.data.phone && (
        <div class="flex items-center text-stone-700">
          <span class="mr-1.5 text-amber-600">📞</span>
          <a href={`tel:${staff.data.phone}`} class="hover:text-amber-800 font-mono font-bold">
            {staff.data.phone}
          </a>
        </div>
      )}
      {staff.data.email && (
        <div class="flex items-center text-stone-700">
          <span class="mr-1.5 text-amber-600">✉️</span>
          <a href={`mailto:${staff.data.email}`} class="hover:text-amber-800">
            {staff.data.email}
          </a>
        </div>
      )}
    </div>
  </div>
</div>
