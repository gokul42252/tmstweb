      // Chart 4: Deity-wise Revenue Distribution
      function renderDeityRevenueChart() {
        const canvas = document.getElementById("chart-deity-revenue") as HTMLCanvasElement;
        if (!canvas) return;

        const deityMap: { [deity: string]: number } = {
          "Lord Shiva": 0,
          "Lord Ganapathy": 0,
          "Lord Sastha / Ayyappan": 0,
          "Goddess Parvathi / Bhagavathi": 0,
          "Nagas / Edaprakavu": 0
        };

        filteredBills.forEach(b => {
          (b.bill_items || []).forEach(item => {
            const rawDeity = (item.deity_name || "").toLowerCase();
            const name = (item.pooja_name || "").toLowerCase();
            const sub = Number(item.subtotal) || 0;

            if (rawDeity.includes("ganapathy") || name.includes("ganapathy") || name.includes("karuka") || name.includes("modakam")) {
              deityMap["Lord Ganapathy"] += sub;
            } else if (rawDeity.includes("sastha") || rawDeity.includes("ayyappan") || name.includes("neerajanam") || name.includes("sastha")) {
              deityMap["Lord Sastha / Ayyappan"] += sub;
            } else if (rawDeity.includes("parvathi") || name.includes("bhagavathi") || name.includes("swayamvara")) {
              deityMap["Goddess Parvathi / Bhagavathi"] += sub;
            } else if (rawDeity.includes("serpent") || rawDeity.includes("naga") || name.includes("noor") || name.includes("sarpa")) {
              deityMap["Nagas / Edaprakavu"] += sub;
            } else {
              deityMap["Lord Shiva"] += sub;
            }
          });
        });

        if (chartDeity) chartDeity.destroy();

        chartDeity = new Chart(canvas, {
          type: "polarArea",
          data: {
            labels: Object.keys(deityMap),
            datasets: [
              {
                data: Object.values(deityMap),
                backgroundColor: [
                  "rgba(217, 119, 6, 0.75)",
                  "rgba(239, 68, 68, 0.75)",
                  "rgba(16, 185, 129, 0.75)",
                  "rgba(168, 85, 247, 0.75)",
                  "rgba(14, 165, 233, 0.75)"
                ]
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: "right", labels: { boxWidth: 10, font: { size: 10 } } },
