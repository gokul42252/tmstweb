    <!-- Client-side Logic Script -->
    <script>
      import { supabase, authenticateStaff, type Bill, type BillItem, type StaffUser } from "../../lib/supabaseClient";
      import { Chart, registerables } from "chart.js";
      import * as XLSX from "xlsx";

      Chart.register(...registerables);

      // Global State
      let currentUser: StaffUser | null = null;
      let allBills: Bill[] = [];
      let filteredBills: Bill[] = [];
      let currentPage = 1;
      const pageSize = 15;

      // Chart Instances
      let chartDaily: Chart | null = null;
      let chartPayment: Chart | null = null;
      let chartTopPoojas: Chart | null = null;
      let chartDeity: Chart | null = null;
      let chartHourly: Chart | null = null;
      let chartStars: Chart | null = null;

      // DOM Elements
      const loginContainer = document.getElementById("login-container");
      const dashboardContainer = document.getElementById("dashboard-container");
      const loginForm = document.getElementById("admin-login-form");
      const loginErrorAlert = document.getElementById("login-error-alert");
      const loginErrorMsg = document.getElementById("login-error-msg");
      const userDisplayName = document.getElementById("user-display-name");
      const userRoleBadge = document.getElementById("user-role-badge");
      const btnLogout = document.getElementById("btn-logout");
      const btnRefresh = document.getElementById("btn-refresh");
      const btnExportExcel = document.getElementById("btn-export-excel");
      const btnExportPdf = document.getElementById("btn-export-pdf");

      const filterDateFrom = document.getElementById("filter-date-from") as HTMLInputElement;
      const filterDateTo = document.getElementById("filter-date-to") as HTMLInputElement;
      const filterCounter = document.getElementById("filter-counter") as HTMLSelectElement;
      const filterPaymentMode = document.getElementById("filter-payment-mode") as HTMLSelectElement;
      const filterSearch = document.getElementById("filter-search") as HTMLInputElement;
      const datePresetBtns = document.querySelectorAll(".date-preset-btn");

      const tableBody = document.getElementById("bills-table-body");
      const tableCountBadge = document.getElementById("table-count-badge");
      const tableFilteredSum = document.getElementById("table-filtered-sum");
      const btnPrevPage = document.getElementById("btn-prev-page") as HTMLButtonElement;
      const btnNextPage = document.getElementById("btn-next-page") as HTMLButtonElement;
      const currentPageNum = document.getElementById("current-page-num");
      const paginationInfo = document.getElementById("table-pagination-info");

      // Set default dates (Today)
      const todayStr = new Date().toISOString().split("T")[0];
      if (filterDateFrom && filterDateTo) {
        filterDateFrom.value = todayStr;
        filterDateTo.value = todayStr;
      }

      // Check session
      checkExistingSession();

      function checkExistingSession() {
        const stored = localStorage.getItem("tm_admin_user");
        if (stored) {
          try {
            currentUser = JSON.parse(stored);
            showDashboard();
            return;
          } catch (e) {
            localStorage.removeItem("tm_admin_user");
          }
        }
        showLogin();
      }

      function showLogin() {
        loginContainer?.classList.remove("hidden");
        dashboardContainer?.classList.add("hidden");
      }

      function showDashboard() {
        loginContainer?.classList.add("hidden");
        dashboardContainer?.classList.remove("hidden");
        dashboardContainer?.classList.add("flex");

        if (userDisplayName && currentUser) {
          userDisplayName.textContent = currentUser.full_name;
        }
        if (userRoleBadge && currentUser) {
          userRoleBadge.textContent = currentUser.role;
        }

        fetchBillsData();
        setupRealtimeSubscription();
      }

      // Helper function for quick demo credential filling
      (window as any).fillCredentials = function(u: string, p: string) {
        const uInput = document.getElementById("login-username") as HTMLInputElement;
        const pInput = document.getElementById("login-password") as HTMLInputElement;
        if (uInput) uInput.value = u;
        if (pInput) pInput.value = p;
      };

      // Login handler
      loginForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        loginErrorAlert?.classList.add("hidden");

        const uInput = (document.getElementById("login-username") as HTMLInputElement).value;
        const pInput = (document.getElementById("login-password") as HTMLInputElement).value;
        const submitBtn = document.getElementById("login-submit-btn");

        if (submitBtn) {
          submitBtn.innerHTML = "<span>🔄 Verifying with Supabase...</span>";
          (submitBtn as HTMLButtonElement).disabled = true;
        }

        const res = await authenticateStaff(uInput, pInput);

        if (res.success && res.user) {
          currentUser = res.user;
          localStorage.setItem("tm_admin_user", JSON.stringify(currentUser));
          showDashboard();
        } else {
          if (loginErrorAlert && loginErrorMsg) {
            loginErrorMsg.textContent = res.error || "Authentication failed.";
            loginErrorAlert.classList.remove("hidden");
          }
        }

        if (submitBtn) {
          submitBtn.innerHTML = "<span>🔓 Sign In to Admin Portal</span>";
          (submitBtn as HTMLButtonElement).disabled = false;
        }
      });

      // Logout handler
      btnLogout?.addEventListener("click", () => {
        if (confirm("Are you sure you want to sign out from the Admin Portal?")) {
          localStorage.removeItem("tm_admin_user");
          currentUser = null;
          showLogin();
        }
      });

      // Fetch all bills with nested bill_items from Supabase
      async function fetchBillsData() {
        const refreshIcon = document.getElementById("refresh-icon");
        if (refreshIcon) refreshIcon.classList.add("animate-spin");

        try {
          const { data, error } = await supabase
            .from("bills")
            .select("*, bill_items(*)")
            .order("created_at", { ascending: false });

          if (error) {
            console.error("Error fetching bills:", error);
            alert("Error connecting to Supabase: " + error.message);
            return;
          }

          allBills = data || [];
          applyFilters();
        } catch (err: any) {
          console.error("Exception fetching bills:", err);
        } finally {
          if (refreshIcon) refreshIcon.classList.remove("animate-spin");
        }
      }

      // Realtime subscription to live bills
      function setupRealtimeSubscription() {
        supabase
          .channel("admin-bills-feed")
          .on(
            "postgres_changes",
            { event: "*", schema: "public", table: "bills" },
            () => {
              fetchBillsData();
            }
          )
          .subscribe();
      }

      btnRefresh?.addEventListener("click", fetchBillsData);

      // Date Presets Handler
      datePresetBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          datePresetBtns.forEach(b => {
            b.classList.remove("active", "bg-amber-600", "text-white");
            b.classList.add("bg-stone-100", "text-stone-700");
          });
          btn.classList.add("active", "bg-amber-600", "text-white");
          btn.classList.remove("bg-stone-100", "text-stone-700");

          const preset = btn.getAttribute("data-preset");
          const now = new Date();
          const today = now.toISOString().split("T")[0];

          if (preset === "today") {
            filterDateFrom.value = today;
            filterDateTo.value = today;
          } else if (preset === "yesterday") {
            const y = new Date(now);
            y.setDate(y.getDate() - 1);
            const yStr = y.toISOString().split("T")[0];
            filterDateFrom.value = yStr;
            filterDateTo.value = yStr;
          } else if (preset === "week") {
            const w = new Date(now);
            w.setDate(w.getDate() - 7);
            filterDateFrom.value = w.toISOString().split("T")[0];
            filterDateTo.value = today;
          } else if (preset === "month") {
            const m = new Date(now.getFullYear(), now.getMonth(), 1);
            filterDateFrom.value = m.toISOString().split("T")[0];
            filterDateTo.value = today;
          } else if (preset === "all") {
            filterDateFrom.value = "2020-01-01";
            filterDateTo.value = "2030-12-31";
          }
          applyFilters();
        });
      });

      // Filter change listeners
      filterDateFrom?.addEventListener("change", applyFilters);
      filterDateTo?.addEventListener("change", applyFilters);
      filterCounter?.addEventListener("change", applyFilters);
      filterPaymentMode?.addEventListener("change", applyFilters);
      filterSearch?.addEventListener("input", applyFilters);

      // Filter and compute stats
      function applyFilters() {
        const fromDate = filterDateFrom?.value || "2000-01-01";
        const toDate = filterDateTo?.value || "2099-12-31";
        const selectedCounter = filterCounter?.value || "ALL";
        const selectedPayment = filterPaymentMode?.value || "ALL";
        const searchVal = (filterSearch?.value || "").trim().toLowerCase();

        filteredBills = allBills.filter(bill => {
          // Date comparison (bill.pooja_date or bill.created_at)
          const billDate = (bill.pooja_date || bill.created_at.split("T")[0]);
          if (billDate < fromDate || billDate > toDate) {
            return false;
          }

          // Counter
          if (selectedCounter !== "ALL" && bill.counter_id !== selectedCounter) {
            return false;
          }

          // Payment mode
          if (selectedPayment !== "ALL" && bill.payment_mode !== selectedPayment) {
            return false;
          }

          // Search
          if (searchVal) {
            const num = (bill.bill_number || "").toLowerCase();
            const name = (bill.devotee_name || "").toLowerCase();
            const star = (bill.star_name || "").toLowerCase();
            const items = (bill.bill_items || []).map(i => i.pooja_name.toLowerCase()).join(" ");
            if (!num.includes(searchVal) && !name.includes(searchVal) && !star.includes(searchVal) && !items.includes(searchVal)) {
              return false;
            }
          }

          return true;
        });

        currentPage = 1;
        updateKpiMetrics();
        updateCharts();
        renderTable();
        updatePrintReport();
      }

      // Update KPI metrics
      function updateKpiMetrics() {
        let totalRev = 0;
        let cashRev = 0;
        let upiRev = 0;
        let totalPoojas = 0;
        const distinctPoojasSet = new Set<string>();

        filteredBills.forEach(b => {
          const amt = Number(b.total_amount) || 0;
          totalRev += amt;
          if (b.payment_mode === "CASH") {
            cashRev += amt;
          } else if (b.payment_mode === "UPI") {
            upiRev += amt;
          }

          (b.bill_items || []).forEach(item => {
            totalPoojas += (item.quantity || 1);
            if (item.pooja_name) distinctPoojasSet.add(item.pooja_name);
          });
        });

        const billsCount = filteredBills.length;
        const avgBill = billsCount > 0 ? Math.round(totalRev / billsCount) : 0;
        const avgItems = billsCount > 0 ? (totalPoojas / billsCount).toFixed(1) : "0";

        const cashPct = totalRev > 0 ? Math.round((cashRev / totalRev) * 100) : 0;
        const upiPct = totalRev > 0 ? Math.round((upiRev / totalRev) * 100) : 0;

        const revEl = document.getElementById("kpi-total-revenue");
        const billsEl = document.getElementById("kpi-total-bills");
        const cashEl = document.getElementById("kpi-cash-total");
        const cashPctEl = document.getElementById("kpi-cash-percent");
        const upiEl = document.getElementById("kpi-upi-total");
        const upiPctEl = document.getElementById("kpi-upi-percent");
        const poojasEl = document.getElementById("kpi-poojas-count");
        const distinctEl = document.getElementById("kpi-distinct-poojas");
        const avgBillEl = document.getElementById("kpi-avg-bill");
        const avgItemsEl = document.getElementById("kpi-avg-items");

        if (revEl) revEl.textContent = `₹${totalRev.toLocaleString("en-IN")}`;
        if (billsEl) billsEl.textContent = `${billsCount} bills`;
        if (cashEl) cashEl.textContent = `₹${cashRev.toLocaleString("en-IN")}`;
        if (cashPctEl) cashPctEl.textContent = `${cashPct}% of total`;
        if (upiEl) upiEl.textContent = `₹${upiRev.toLocaleString("en-IN")}`;
        if (upiPctEl) upiPctEl.textContent = `${upiPct}% of total`;
        if (poojasEl) poojasEl.textContent = totalPoojas.toLocaleString("en-IN");
        if (distinctEl) distinctEl.textContent = `${distinctPoojasSet.size} varieties`;
        if (avgBillEl) avgBillEl.textContent = `₹${avgBill.toLocaleString("en-IN")}`;
        if (avgItemsEl) avgItemsEl.textContent = `${avgItems} poojas/bill`;

        if (tableFilteredSum) tableFilteredSum.textContent = `₹${totalRev.toLocaleString("en-IN")}`;
        if (tableCountBadge) tableCountBadge.textContent = `${billsCount} Records`;
      }

      // Update Charts
      function updateCharts() {
        renderDailyRevenueChart();
        renderPaymentModeChart();
        renderTopPoojasChart();
        renderDeityRevenueChart();
        renderHourlyChart();
        renderStarsChart();
      }

      // Chart 1: Daily Revenue Trend (Stacked Bar)
      function renderDailyRevenueChart() {
        const canvas = document.getElementById("chart-daily-revenue") as HTMLCanvasElement;
        if (!canvas) return;

        // Group by Date
        const dateMap: { [date: string]: { total: number; cash: number; upi: number } } = {};

        filteredBills.forEach(b => {
          const d = b.pooja_date || b.created_at.split("T")[0];
          if (!dateMap[d]) dateMap[d] = { total: 0, cash: 0, upi: 0 };
          const amt = Number(b.total_amount) || 0;
          dateMap[d].total += amt;
          if (b.payment_mode === "CASH") dateMap[d].cash += amt;
          else if (b.payment_mode === "UPI") dateMap[d].upi += amt;
        });

        const sortedDates = Object.keys(dateMap).sort();
        const cashData = sortedDates.map(d => dateMap[d].cash);
        const upiData = sortedDates.map(d => dateMap[d].upi);

        if (chartDaily) chartDaily.destroy();

        chartDaily = new Chart(canvas, {
          type: "bar",
          data: {
            labels: sortedDates.map(d => d.slice(5)), // MM-DD
            datasets: [
              {
                label: "Cash Collection (₹)",
                data: cashData,
                backgroundColor: "#10b981",
                borderRadius: 4
              },
              {
                label: "UPI / QR (₹)",
                data: upiData,
                backgroundColor: "#3b82f6",
                borderRadius: 4
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: "top", labels: { boxWidth: 12, font: { size: 11 } } },
              tooltip: {
                callbacks: {
                  label: (ctx) => `${ctx.dataset.label}: ₹${(ctx.parsed.y || 0).toLocaleString("en-IN")}`
                }
              }
            },
            scales: {
              x: { stacked: true, grid: { display: false } },
              y: {
                stacked: true,
                ticks: {
                  callback: (val) => "₹" + Number(val).toLocaleString("en-IN")
                }
              }
            }
          }
        });
      }

