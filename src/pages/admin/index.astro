                callbacks: {
                  label: (ctx) => `${ctx.label}: ₹${Number(ctx.parsed.r || 0).toLocaleString("en-IN")}`
                }
              }
            }
          }
        });
      }

      // Chart 5: Peak Hours Distribution
      function renderHourlyChart() {
        const canvas = document.getElementById("chart-hourly-distribution") as HTMLCanvasElement;
        if (!canvas) return;

        // Group into 2-hour slots across 24h
        const slots: { [slot: string]: number } = {
          "04:00 - 06:00 (Nirmalyam)": 0,
          "06:00 - 08:00 (Usha Pooja)": 0,
          "08:00 - 10:30 (Ucha Pooja)": 0,
          "10:30 - 17:00 (Afternoon)": 0,
          "17:00 - 19:00 (Deeparadhana)": 0,
          "19:00 - 21:00 (Athazha Pooja)": 0,
          "Night / Other": 0
        };

        filteredBills.forEach(b => {
          if (!b.created_at) return;
          const dt = new Date(b.created_at);
          const hr = dt.getHours();
          const amt = Number(b.total_amount) || 0;

          if (hr >= 4 && hr < 6) slots["04:00 - 06:00 (Nirmalyam)"] += amt;
          else if (hr >= 6 && hr < 8) slots["06:00 - 08:00 (Usha Pooja)"] += amt;
          else if (hr >= 8 && hr < 11) slots["08:00 - 10:30 (Ucha Pooja)"] += amt;
          else if (hr >= 11 && hr < 17) slots["10:30 - 17:00 (Afternoon)"] += amt;
          else if (hr >= 17 && hr < 19) slots["17:00 - 19:00 (Deeparadhana)"] += amt;
          else if (hr >= 19 && hr < 21) slots["19:00 - 21:00 (Athazha Pooja)"] += amt;
          else slots["Night / Other"] += amt;
        });

        if (chartHourly) chartHourly.destroy();

        chartHourly = new Chart(canvas, {
          type: "bar",
          data: {
            labels: Object.keys(slots),
            datasets: [
              {
                label: "Billing Volume (₹)",
                data: Object.values(slots),
                backgroundColor: "#6366f1",
                borderRadius: 4
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: (ctx) => `Revenue: ₹${Number(ctx.parsed.y || 0).toLocaleString("en-IN")}`
                }
              }
            },
            scales: {
              x: { ticks: { font: { size: 9 } } },
              y: {
                ticks: {
                  callback: (val) => "₹" + Number(val).toLocaleString("en-IN")
                }
              }
            }
          }
        });
      }

      // Chart 6: Devotee Birth Stars (Nakshatra)
      function renderStarsChart() {
        const canvas = document.getElementById("chart-star-distribution") as HTMLCanvasElement;
        if (!canvas) return;

        const starMap: { [star: string]: number } = {};

        filteredBills.forEach(b => {
          const star = (b.star_name || "Not Specified").split("-")[0].trim();
          if (!starMap[star]) starMap[star] = 0;
          starMap[star]++;
        });

        const sorted = Object.entries(starMap)
          .sort((a, b) => b[1] - a[1])
          .slice(0, 8);

        if (chartStars) chartStars.destroy();

        chartStars = new Chart(canvas, {
          type: "bar",
          data: {
            labels: sorted.map(s => s[0]),
            datasets: [
              {
                label: "Receipts Count",
                data: sorted.map(s => s[1]),
                backgroundColor: "#ec4899",
                borderRadius: 4
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false }
            },
            scales: {
              x: { ticks: { font: { size: 10 } } },
              y: {
                ticks: { stepSize: 1 }
              }
            }
          }
        });
      }

      // Render Transaction Ledger Table
      function renderTable() {
        if (!tableBody) return;

        if (filteredBills.length === 0) {
          tableBody.innerHTML = `
            <tr>
              <td colspan="9" class="py-12 text-center text-stone-400 italic">
                No receipts found matching the selected filter criteria.
              </td>
            </tr>
          `;
          if (paginationInfo) paginationInfo.textContent = "0 of 0 records";
          return;
        }

        const totalPages = Math.ceil(filteredBills.length / pageSize) || 1;
        if (currentPage > totalPages) currentPage = totalPages;

        const startIndex = (currentPage - 1) * pageSize;
        const endIndex = Math.min(startIndex + pageSize, filteredBills.length);
        const pageBills = filteredBills.slice(startIndex, endIndex);

        tableBody.innerHTML = "";

        pageBills.forEach(bill => {
          const row = document.createElement("tr");
          row.className = "hover:bg-amber-50/40 transition-colors border-b border-stone-100 group";

          const itemsCount = (bill.bill_items || []).length;
          const itemsSummary = (bill.bill_items || []).map(i => `${i.pooja_name} (x${i.quantity})`).join(", ");

          // Payment mode badge
          const payBadge = bill.payment_mode === "CASH" 
            ? `<span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold text-[10px]">CASH</span>`
            : `<span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 font-bold text-[10px]">${bill.payment_mode}</span>`;

          const dt = new Date(bill.created_at);
          const timeFormatted = dt.toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" });
          const dateFormatted = bill.pooja_date || dt.toISOString().split("T")[0];

          row.innerHTML = `
            <td class="py-3 px-4 font-mono font-bold text-amber-900 whitespace-nowrap">
              ${bill.bill_number}
            </td>
            <td class="py-3 px-4 whitespace-nowrap text-stone-600">
              <span class="block font-semibold text-stone-900">${dateFormatted}</span>
              <span class="text-[10px] text-stone-400">${timeFormatted}</span>
            </td>
            <td class="py-3 px-4 font-bold text-stone-900">
              ${bill.devotee_name}
            </td>
            <td class="py-3 px-4 font-malayalam text-stone-700">
              ${bill.star_name}
            </td>
            <td class="py-3 px-4 max-w-xs">
              <span class="inline-block px-1.5 py-0.5 rounded bg-stone-100 font-bold text-[10px] text-stone-700 mr-1.5">
                ${itemsCount} pooja${itemsCount > 1 ? "s" : ""}
              </span>
              <span class="text-stone-500 truncate inline-block max-w-[200px] align-middle" title="${itemsSummary}">
                ${itemsSummary}
              </span>
            </td>
            <td class="py-3 px-4 text-center whitespace-nowrap">
              ${payBadge}
            </td>
            <td class="py-3 px-4 text-[11px] text-stone-500 whitespace-nowrap">
              ${bill.counter_id === 'ONLINE' ? '<span class="inline-block px-1.5 py-0.5 rounded bg-blue-100 text-blue-800 font-bold text-[10px]">🌐 ONLINE</span>' : `<span class="font-bold text-stone-700 block">${bill.counter_id}</span>`}
              <span class="block truncate max-w-[150px]" title="${bill.billed_by || 'Operator'}">${bill.billed_by || "Operator"}</span>
            </td>
            <td class="py-3 px-4 text-right font-serif font-black text-amber-900 text-sm whitespace-nowrap">
              ₹${Number(bill.total_amount).toLocaleString("en-IN")}
            </td>
            <td class="py-3 px-3 text-center no-print whitespace-nowrap">
              <button
                type="button"
                class="view-breakdown-btn px-2 py-1 rounded bg-stone-100 hover:bg-amber-100 text-stone-700 hover:text-amber-900 text-[10px] font-bold transition-colors"
                data-id="${bill.id}"
              >
                Expand ↓
              </button>
            </td>
          `;

          // Expandable Line Items Details Row
          const detailRow = document.createElement("tr");
          detailRow.id = `detail-${bill.id}`;
          detailRow.className = "hidden bg-stone-50/80 border-b border-stone-200 text-xs";
          
          let lineItemsHtml = "";
          (bill.bill_items || []).forEach((item, i) => {
            lineItemsHtml += `
              <div class="flex items-center justify-between py-1.5 border-b border-stone-200/60 last:border-0 text-xs">
                <div class="flex items-center space-x-2">
                  <span class="w-5 h-5 rounded-full bg-amber-500/10 text-amber-800 font-bold text-[10px] flex items-center justify-center">${i + 1}</span>
                  <div>
                    <span class="font-bold text-stone-900">${item.pooja_name}</span>
                    <span class="text-[10px] text-stone-500 ml-1">(${item.deity_name})</span>
                  </div>
                </div>
                <div class="font-mono text-stone-700">
                  <span>${item.quantity} × ₹${item.unit_price}</span>
                  <span class="ml-3 font-bold text-amber-900">= ₹${item.subtotal}</span>
                </div>
              </div>
            `;
          });

          detailRow.innerHTML = `
            <td colspan="9" class="p-4 pl-12">
              <div class="p-3.5 rounded-xl bg-white border border-stone-200 shadow-sm max-w-2xl">
                <div class="flex items-center justify-between pb-2 mb-2 border-b border-stone-200 text-xs">
                  <span class="font-bold text-stone-900 uppercase tracking-wider text-[11px]">
                    Itemized Pooja Breakdown (Bill: ${bill.bill_number})
                  </span>
                  <span class="font-mono font-bold text-amber-900">
                    Grand Total: ₹${bill.total_amount}
                  </span>
                </div>
                <div class="space-y-1">
                  ${lineItemsHtml || "<p class='text-stone-400 italic text-xs'>No line item records.</p>"}
                </div>
              </div>
            </td>
          `;

          tableBody.appendChild(row);
          tableBody.appendChild(detailRow);
        });

        // Add toggle listeners
        tableBody.querySelectorAll(".view-breakdown-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            const id = btn.getAttribute("data-id");
            const targetRow = document.getElementById(`detail-${id}`);
            if (targetRow) {
              const isHidden = targetRow.classList.contains("hidden");
              if (isHidden) {
                targetRow.classList.remove("hidden");
                btn.textContent = "Collapse ↑";
              } else {
                targetRow.classList.add("hidden");
                btn.textContent = "Expand ↓";
              }
            }
          });
        });

        // Pagination UI update
        if (paginationInfo) {
          paginationInfo.textContent = `Showing ${startIndex + 1} to ${endIndex} of ${filteredBills.length} records`;
        }
        if (currentPageNum) currentPageNum.textContent = String(currentPage);
        if (btnPrevPage) btnPrevPage.disabled = currentPage <= 1;
        if (btnNextPage) btnNextPage.disabled = currentPage >= totalPages;
      }

      btnPrevPage?.addEventListener("click", () => {
        if (currentPage > 1) {
          currentPage--;
          renderTable();
        }
      });

      btnNextPage?.addEventListener("click", () => {
        const totalPages = Math.ceil(filteredBills.length / pageSize) || 1;
        if (currentPage < totalPages) {
          currentPage++;
          renderTable();
        }
      });

      // =========================================================================
      // EXCEL EXPORT HANDLER (.xlsx)
      // =========================================================================
      btnExportExcel?.addEventListener("click", () => {
        if (filteredBills.length === 0) {
          alert("No records to export.");
          return;
        }

        // Sheet 1: Summary of Bills
        const summaryData = filteredBills.map(b => ({
          "Bill Number": b.bill_number,
          "Date": b.pooja_date || b.created_at.split("T")[0],
          "Time (IST)": new Date(b.created_at).toLocaleTimeString("en-IN"),
          "Devotee Name": b.devotee_name,
          "Birth Star (Nakshatra)": b.star_name,
          "Gothram": b.gothram || "",
          "Payment Mode": b.payment_mode,
          "Counter Machine": b.counter_id,
          "Billed By": b.billed_by || "Operator",
          "Total Amount (INR)": Number(b.total_amount),
          "Items Count": (b.bill_items || []).length
        }));

        // Sheet 2: Itemized Line Items
        const itemizedData: any[] = [];
        filteredBills.forEach(b => {
          (b.bill_items || []).forEach(item => {
            itemizedData.push({
              "Bill Number": b.bill_number,
              "Date": b.pooja_date || b.created_at.split("T")[0],
              "Devotee Name": b.devotee_name,
              "Offering Name": item.pooja_name,
              "Deity": item.deity_name,
              "Quantity": item.quantity,
              "Unit Price (INR)": Number(item.unit_price),
              "Subtotal (INR)": Number(item.subtotal),
              "Payment Mode": b.payment_mode
            });
          });
        });

        // Sheet 3: Pooja-wise Totals
        const poojaAggMap: { [name: string]: { deity: string; qty: number; rev: number } } = {};
        filteredBills.forEach(b => {
          (b.bill_items || []).forEach(item => {
            const name = item.pooja_name;
            if (!poojaAggMap[name]) poojaAggMap[name] = { deity: item.deity_name, qty: 0, rev: 0 };
            poojaAggMap[name].qty += Number(item.quantity) || 1;
            poojaAggMap[name].rev += Number(item.subtotal) || 0;
          });
        });

        const poojaAggData = Object.entries(poojaAggMap).map(([name, data]) => ({
          "Offering Name": name,
          "Associated Deity": data.deity,
          "Total Quantity Sold": data.qty,
          "Total Revenue (INR)": data.rev
        })).sort((a, b) => b["Total Revenue (INR)"] - a["Total Revenue (INR)"]);

        // Create workbook
        const wb = XLSX.utils.book_new();

        const ws1 = XLSX.utils.json_to_sheet(summaryData);
        const ws2 = XLSX.utils.json_to_sheet(itemizedData);
        const ws3 = XLSX.utils.json_to_sheet(poojaAggData);

        XLSX.utils.book_append_sheet(wb, ws1, "Bills Summary");
        XLSX.utils.book_append_sheet(wb, ws2, "Itemized Poojas");
        XLSX.utils.book_append_sheet(wb, ws3, "Pooja Aggregates");

        const from = filterDateFrom?.value || "start";
        const to = filterDateTo?.value || "end";
        const fileName = `Thirumarady_Temple_Billing_Report_${from}_to_${to}.xlsx`;

        XLSX.writeFile(wb, fileName);
      });

      // =========================================================================
      // PDF AUDIT REPORT / PRINT HANDLER
      // =========================================================================
      btnExportPdf?.addEventListener("click", () => {
        updatePrintReport();
        const from = filterDateFrom?.value || "All";
        const to = filterDateTo?.value || "Time";
        const originalTitle = document.title;
        document.title = `Thirumarady_Temple_Audit_Statement_${from}_to_${to}`;
        window.print();
        setTimeout(() => {
          document.title = originalTitle;
        }, 1500);
      });

      function updatePrintReport() {
        const from = filterDateFrom?.value || "Start";
        const to = filterDateTo?.value || "End";
        const counter = filterCounter?.value || "All Counters";

        const pRange = document.getElementById("print-date-range");
        const pCounter = document.getElementById("print-counter");
        const pTime = document.getElementById("print-timestamp");
        const pOfficer = document.getElementById("print-officer");

        if (pRange) pRange.textContent = `${from} to ${to}`;
        if (pCounter) pCounter.textContent = counter;
        if (pTime) pTime.textContent = new Date().toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" });
        if (pOfficer && currentUser) pOfficer.textContent = currentUser.full_name;

        // KPI metrics for print
        let total = 0;
        let cash = 0;
        let upi = 0;
        const poojaMap: { [name: string]: { deity: string; qty: number; rev: number } } = {};

        filteredBills.forEach(b => {
          const amt = Number(b.total_amount) || 0;
          total += amt;
          const mode = (b.payment_mode || "").toUpperCase();
          if (mode === "CASH") cash += amt;
          else if (mode === "UPI") upi += amt;

          (b.bill_items || []).forEach(item => {
            const name = item.pooja_name;
            if (!poojaMap[name]) poojaMap[name] = { deity: item.deity_name, qty: 0, rev: 0 };
            poojaMap[name].qty += Number(item.quantity) || 1;
            poojaMap[name].rev += Number(item.subtotal) || 0;
          });
        });

        const printBills = document.getElementById("print-kpi-bills");
        const printCash = document.getElementById("print-kpi-cash");
        const printUpi = document.getElementById("print-kpi-upi");
        const printTotal = document.getElementById("print-kpi-total");

        if (printBills) printBills.textContent = `${filteredBills.length} bills`;
        if (printCash) printCash.textContent = `₹${cash.toLocaleString("en-IN")}`;
        if (printUpi) printUpi.textContent = `₹${upi.toLocaleString("en-IN")}`;
        if (printTotal) printTotal.textContent = `₹${total.toLocaleString("en-IN")}`;

        // 1. Populate pooja summary table in print
        const printPoojaBody = document.getElementById("print-pooja-summary-body");
        if (printPoojaBody) {
          const sorted = Object.entries(poojaMap).sort((a, b) => b[1].rev - a[1].rev);
          let rowsHtml = "";
          sorted.forEach(([name, d], idx) => {
            rowsHtml += `
              <tr class="even:bg-stone-50/50">
                <td class="p-2 border border-stone-300 text-center">${idx + 1}</td>
                <td class="p-2 border border-stone-300 font-bold" style="font-family: 'Noto Sans Malayalam', 'Nirmala UI', sans-serif;">${name}</td>
                <td class="p-2 border border-stone-300">${d.deity}</td>
                <td class="p-2 border border-stone-300 text-center font-bold">${d.qty}</td>
                <td class="p-2 border border-stone-300 text-right font-bold">₹${d.rev.toLocaleString("en-IN")}</td>
              </tr>
            `;
          });
          printPoojaBody.innerHTML = rowsHtml || `<tr><td colspan="5" class="p-4 text-center">No poojas booked in this period.</td></tr>`;
        }

        // 2. Populate devotee receipts audit register in print
        const printReceiptsBody = document.getElementById("print-receipts-summary-body");
        if (printReceiptsBody) {
          let receiptsHtml = "";
          filteredBills.forEach((b, idx) => {
            const timeStr = b.created_at
              ? new Date(b.created_at).toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" }) + " " + new Date(b.created_at).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" })
              : (b.pooja_date || "-");
            const itemsStr = (b.bill_items || []).map(i => `${i.pooja_name} (x${i.quantity})`).join(", ") || "General Offering";
            receiptsHtml += `
              <tr class="even:bg-stone-50/50">
                <td class="p-1.5 border border-stone-300 text-center text-stone-500">${idx + 1}</td>
                <td class="p-1.5 border border-stone-300 font-mono font-bold whitespace-nowrap">${b.bill_number}</td>
                <td class="p-1.5 border border-stone-300 text-stone-600 whitespace-nowrap text-[9px]">${timeStr}</td>
                <td class="p-1.5 border border-stone-300 font-bold">${b.devotee_name}</td>
                <td class="p-1.5 border border-stone-300 whitespace-nowrap" style="font-family: 'Noto Sans Malayalam', 'Nirmala UI', sans-serif;">${b.star_name}</td>
                <td class="p-1.5 border border-stone-300 max-w-[200px] truncate" style="font-family: 'Noto Sans Malayalam', 'Nirmala UI', sans-serif;" title="${itemsStr}">${itemsStr}</td>
                <td class="p-1.5 border border-stone-300 text-center font-bold text-[9px]">${b.payment_mode}</td>
                <td class="p-1.5 border border-stone-300 text-right font-mono font-bold">₹${Number(b.total_amount).toLocaleString("en-IN")}</td>
              </tr>
            `;
          });
          printReceiptsBody.innerHTML = receiptsHtml || `<tr><td colspan="8" class="p-3 text-center text-stone-500">No receipts found for selected period.</td></tr>`;
        }
      }

      // ============================================================================
      // POOJA & VAZHIPADU CATALOG MANAGEMENT LOGIC
      // ============================================================================

      function showToast(message: string, type: "success" | "error" | "info" = "success") {
        const container = document.getElementById("toast-container");
        if (!container) return;
        const toast = document.createElement("div");
        toast.className = `pointer-events-auto p-3.5 rounded-xl text-xs font-semibold shadow-2xl border flex items-center gap-2.5 transition-all transform duration-200 ${
          type === "success"
            ? "bg-stone-900 text-emerald-300 border-emerald-500/50"
            : type === "error"
            ? "bg-red-950 text-red-200 border-red-500/50"
            : "bg-stone-900 text-amber-300 border-amber-500/50"
        }`;
        const icon = type === "success" ? "✅" : type === "error" ? "❌" : "ℹ️";
        toast.innerHTML = `<span class="text-base">${icon}</span><span class="flex-1">${message}</span>`;
        container.appendChild(toast);
        setTimeout(() => {
          toast.classList.add("opacity-0", "translate-y-2");
          setTimeout(() => toast.remove(), 300);
        }, 4000);
      }

      function switchTab(tab: "billing" | "poojas") {
        currentTab = tab;
        if (tab === "billing") {
          tabContentBilling?.classList.remove("hidden");
          tabContentPoojas?.classList.add("hidden");

          tabBtnBilling?.classList.add("bg-amber-500", "text-stone-950", "shadow-sm");
          tabBtnBilling?.classList.remove("bg-stone-800", "text-stone-300");

          tabBtnPoojas?.classList.add("bg-stone-800", "text-stone-300");
          tabBtnPoojas?.classList.remove("bg-amber-500", "text-stone-950", "shadow-sm");

          billingNavActions?.classList.remove("hidden");
          billingNavActions?.classList.add("flex");
          poojaNavActions?.classList.add("hidden");
          poojaNavActions?.classList.remove("flex");
        } else {
          tabContentBilling?.classList.add("hidden");
          tabContentPoojas?.classList.remove("hidden");

          tabBtnPoojas?.classList.add("bg-amber-500", "text-stone-950", "shadow-sm");
          tabBtnPoojas?.classList.remove("bg-stone-800", "text-stone-300");

          tabBtnBilling?.classList.add("bg-stone-800", "text-stone-300");
          tabBtnBilling?.classList.remove("bg-amber-500", "text-stone-950", "shadow-sm");

          billingNavActions?.classList.add("hidden");
          billingNavActions?.classList.remove("flex");
          poojaNavActions?.classList.remove("hidden");
          poojaNavActions?.classList.add("flex");

          if (allPoojas.length === 0) {
            loadPoojasData();
          }
        }
      }

      tabBtnBilling?.addEventListener("click", () => switchTab("billing"));
      tabBtnPoojas?.addEventListener("click", () => switchTab("poojas"));

      async function loadPoojasData() {
        const icon = document.getElementById("refresh-poojas-icon");
        if (icon) icon.classList.add("animate-spin");

        const res = await fetchPoojas();
        if (icon) icon.classList.remove("animate-spin");

        if (res.success && res.data) {
          allPoojas = res.data;
          updatePoojaStats();
          applyPoojaFilters();
        } else {
          showToast(res.error || "Failed to load poojas from database.", "error");
        }
      }

      function updatePoojaStats() {
        const total = allPoojas.length;
        const active = allPoojas.filter(p => p.is_active).length;
        const inactive = total - active;
        const deities = new Set(allPoojas.map(p => p.deity_name.trim())).size;

        let minRate = 0;
        let maxRate = 0;
        if (total > 0) {
          const prices = allPoojas.map(p => Number(p.price) || 0);
          minRate = Math.min(...prices);
          maxRate = Math.max(...prices);
        }

        if (poojaKpiTotal) poojaKpiTotal.textContent = String(total);
        if (poojaKpiActive) poojaKpiActive.textContent = String(active);
        if (poojaKpiInactive) poojaKpiInactive.textContent = String(inactive);
        if (poojaKpiDeities) poojaKpiDeities.textContent = String(deities);
        if (poojaKpiRange) poojaKpiRange.textContent = total > 0 ? `₹${minRate} - ₹${maxRate}` : "₹0";

        if (navPoojaCountBadge) navPoojaCountBadge.textContent = String(total);
        if (poojaTotalCount) poojaTotalCount.textContent = String(total);
      }

      function applyPoojaFilters() {
        const searchTerm = (poojaSearchInput?.value || "").toLowerCase().trim();
        const deityVal = poojaDeityFilter?.value || "ALL";
        const statusVal = poojaStatusFilter?.value || "ALL";
        const sortBy = poojaSortBy?.value || "code-asc";

        filteredPoojas = allPoojas.filter(p => {
          if (searchTerm) {
            const matchCode = (p.code || "").toLowerCase().includes(searchTerm);
            const matchEn = (p.name_en || "").toLowerCase().includes(searchTerm);
            const matchMl = (p.name_ml || "").toLowerCase().includes(searchTerm);
            const matchDeity = (p.deity_name || "").toLowerCase().includes(searchTerm);
            if (!matchCode && !matchEn && !matchMl && !matchDeity) return false;
          }

          if (deityVal !== "ALL") {
            if (deityVal === "OTHER") {
              const standard = ["shiva", "parvathi", "ganapathy", "sastha", "subrahmanian", "nagaraja"];
              if (standard.includes(p.deity_name.toLowerCase())) return false;
            } else {
              if (p.deity_name.toLowerCase() !== deityVal.toLowerCase()) return false;
            }
          }

          if (statusVal === "ACTIVE" && !p.is_active) return false;
          if (statusVal === "INACTIVE" && p.is_active) return false;

          return true;
        });

        filteredPoojas.sort((a, b) => {
          if (sortBy === "code-asc") return (parseInt(a.code) || 0) - (parseInt(b.code) || 0);
          if (sortBy === "code-desc") return (parseInt(b.code) || 0) - (parseInt(a.code) || 0);
          if (sortBy === "price-asc") return Number(a.price) - Number(b.price);
          if (sortBy === "price-desc") return Number(b.price) - Number(a.price);
          if (sortBy === "name-asc") return a.name_en.localeCompare(b.name_en);
          return 0;
        });

        if (poojaFilteredCount) poojaFilteredCount.textContent = String(filteredPoojas.length);

        renderPoojasTable();
      }

      function getDeityBadge(deity: string) {
        const d = (deity || "").toLowerCase();
        if (d.includes("shiva")) {
          return `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-sky-50 text-sky-800 border border-sky-200">🔱 Shiva (ശിവൻ)</span>`;
        } else if (d.includes("parvath") || d.includes("devi") || d.includes("bhagavathi")) {
          return `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-800 border border-rose-200">🌸 Parvathi (പാർവ്വതി)</span>`;
        } else if (d.includes("ganapath") || d.includes("vinayak") || d.includes("vigneswara")) {
          return `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-900 border border-amber-200">🐘 Ganapathy (ഗണപതി)</span>`;
        } else if (d.includes("sastha") || d.includes("ayyappan") || d.includes("dharmasastha")) {
          return `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-orange-50 text-orange-900 border border-orange-200">🏹 Sastha (ശാസ്താവ്)</span>`;
        } else if (d.includes("subrahman") || d.includes("murugan")) {
          return `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-teal-50 text-teal-900 border border-teal-200">🦚 Subrahmanian (സുബ്രഹ്മണ്യൻ)</span>`;
        } else if (d.includes("naga") || d.includes("serpent") || d.includes("sarpa")) {
          return `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-900 border border-emerald-200">🐍 Nagaraja (നാഗങ്ങൾ)</span>`;
        }
        return `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-stone-100 text-stone-700 border border-stone-200">🪔 ${deity}</span>`;
      }

      function renderPoojasTable() {
        if (!poojasTableBody) return;

        if (filteredPoojas.length === 0) {
          poojasTableBody.innerHTML = `
            <tr>
              <td colspan="6" class="p-8 text-center">
                <div class="max-w-sm mx-auto space-y-2 text-stone-500">
                  <span class="text-3xl block">🔍</span>
                  <p class="font-bold text-stone-800">No offerings match your search/filter.</p>
                  <p class="text-xs text-stone-400">Try adjusting your keyword or reset filters.</p>
                </div>
              </td>
            </tr>
          `;
          return;
        }

        let html = "";
        filteredPoojas.forEach(p => {
          const deityBadge = getDeityBadge(p.deity_name);
          const statusBtn = p.is_active
            ? `<button type="button" class="btn-toggle-active px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 hover:bg-emerald-200 text-emerald-800 border border-emerald-300 transition-colors inline-flex items-center gap-1.5 cursor-pointer shadow-2xs" data-id="${p.id}" data-active="true" title="Click to Deactivate offering">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>Active (സജീവം)</span>
              </button>`
            : `<button type="button" class="btn-toggle-active px-2.5 py-1 rounded-full text-[11px] font-bold bg-stone-100 hover:bg-stone-200 text-stone-600 border border-stone-300 transition-colors inline-flex items-center gap-1.5 cursor-pointer shadow-2xs" data-id="${p.id}" data-active="false" title="Click to Activate offering">
                <span class="w-1.5 h-1.5 rounded-full bg-stone-400"></span>
                <span>Inactive (നിർജ്ജീവം)</span>
              </button>`;

          html += `
            <tr class="hover:bg-amber-50/30 transition-colors group">
              <!-- Code -->
              <td class="p-3.5 text-center">
                <span class="font-mono font-bold text-xs px-2 py-0.5 rounded bg-amber-50 text-amber-900 border border-amber-200">
                  #${p.code}
                </span>
              </td>

              <!-- Names -->
              <td class="p-3.5">
                <div class="font-bold text-stone-900 text-xs sm:text-sm">${p.name_en}</div>
                ${p.name_ml ? `<div class="font-malayalam text-amber-800 text-[11px] font-medium mt-0.5">${p.name_ml}</div>` : ""}
              </td>

              <!-- Deity -->
              <td class="p-3.5 whitespace-nowrap">
                ${deityBadge}
              </td>

              <!-- Rate -->
              <td class="p-3.5 text-right whitespace-nowrap">
                <span class="font-mono font-black text-sm text-stone-900">₹${Number(p.price).toFixed(2)}</span>
              </td>

              <!-- Status -->
              <td class="p-3.5 text-center whitespace-nowrap">
                ${statusBtn}
              </td>

              <!-- Actions -->
              <td class="p-3.5 text-right whitespace-nowrap">
                <div class="flex items-center justify-end gap-1.5">
                  <button
                    type="button"
                    class="btn-edit-pooja px-2.5 py-1.5 rounded-lg bg-white hover:bg-amber-100 text-stone-700 hover:text-amber-900 border border-stone-300 text-xs font-semibold flex items-center gap-1 transition-colors shadow-2xs"
                    data-id="${p.id}"
                    title="Modify offering details and rate"
                  >
                    <span>✏️</span>
                    <span class="hidden sm:inline">Edit</span>
                  </button>

                  <button
                    type="button"
                    class="btn-delete-pooja px-2.5 py-1.5 rounded-lg bg-white hover:bg-red-50 text-stone-600 hover:text-red-700 border border-stone-300 text-xs font-semibold flex items-center gap-1 transition-colors shadow-2xs"
                    data-id="${p.id}"
                    title="Remove offering"
                  >
                    <span>🗑️</span>
                    <span class="hidden sm:inline">Remove</span>
                  </button>
                </div>
              </td>
            </tr>
          `;
        });

        poojasTableBody.innerHTML = html;
        attachPoojaRowListeners();
      }

      function attachPoojaRowListeners() {
        // Toggle active status
        document.querySelectorAll(".btn-toggle-active").forEach(btn => {
          btn.addEventListener("click", async (e) => {
            const el = e.currentTarget as HTMLElement;
            const id = el.getAttribute("data-id");
            const currentActive = el.getAttribute("data-active") === "true";
            if (!id) return;

            el.innerHTML = "<span>⏳ Updating...</span>";
            (el as HTMLButtonElement).disabled = true;

            const res = await updatePooja(id, { is_active: !currentActive });
            if (res.success) {
              showToast(
                `Offering '${res.data?.name_en || id}' is now ${!currentActive ? "Active (സജീവം)" : "Inactive (നിർജ്ജീവം)"}.`,
                "success"
              );
              loadPoojasData();
            } else {
              showToast(res.error || "Failed to update offering status.", "error");
              renderPoojasTable();
            }
          });
        });

        // Edit button
        document.querySelectorAll(".btn-edit-pooja").forEach(btn => {
          btn.addEventListener("click", (e) => {
            const id = (e.currentTarget as HTMLElement).getAttribute("data-id");
            if (id) openEditPoojaModal(id);
          });
        });

        // Delete button
        document.querySelectorAll(".btn-delete-pooja").forEach(btn => {
          btn.addEventListener("click", (e) => {
            const id = (e.currentTarget as HTMLElement).getAttribute("data-id");
            if (id) openDeletePoojaModal(id);
          });
        });
      }

      function openAddPoojaModal() {
        let maxCode = 100;
        allPoojas.forEach(p => {
          const n = parseInt(p.code);
          if (!isNaN(n) && n > maxCode) maxCode = n;
        });

        const codeInput = document.getElementById("add-pooja-code") as HTMLInputElement;
        const nameEnInput = document.getElementById("add-pooja-name-en") as HTMLInputElement;
        const nameMlInput = document.getElementById("add-pooja-name-ml") as HTMLInputElement;
        const deitySelect = document.getElementById("add-pooja-deity") as HTMLSelectElement;
        const priceInput = document.getElementById("add-pooja-price") as HTMLInputElement;
        const activeInput = document.getElementById("add-pooja-active") as HTMLInputElement;
        const errDiv = document.getElementById("add-pooja-error");

        if (codeInput) codeInput.value = String(maxCode + 1);
        if (nameEnInput) nameEnInput.value = "";
        if (nameMlInput) nameMlInput.value = "";
        if (deitySelect) deitySelect.value = "Shiva";
        if (priceInput) priceInput.value = "";
        if (activeInput) activeInput.checked = true;
        if (errDiv) errDiv.classList.add("hidden");

        modalAddPooja?.classList.remove("hidden");
        nameEnInput?.focus();
      }

      function openEditPoojaModal(id: string) {
        const p = allPoojas.find(item => item.id === id);
        if (!p) return;

        const idInput = document.getElementById("edit-pooja-id") as HTMLInputElement;
        const codeInput = document.getElementById("edit-pooja-code") as HTMLInputElement;
        const nameEnInput = document.getElementById("edit-pooja-name-en") as HTMLInputElement;
        const nameMlInput = document.getElementById("edit-pooja-name-ml") as HTMLInputElement;
        const deitySelect = document.getElementById("edit-pooja-deity") as HTMLSelectElement;
        const priceInput = document.getElementById("edit-pooja-price") as HTMLInputElement;
        const activeInput = document.getElementById("edit-pooja-active") as HTMLInputElement;
        const errDiv = document.getElementById("edit-pooja-error");

        if (idInput) idInput.value = p.id;
        if (codeInput) codeInput.value = p.code;
        if (nameEnInput) nameEnInput.value = p.name_en;
        if (nameMlInput) nameMlInput.value = p.name_ml || "";
        if (deitySelect) {
          let match = false;
          for (let i = 0; i < deitySelect.options.length; i++) {
            if (deitySelect.options[i].value.toLowerCase() === p.deity_name.toLowerCase()) {
              deitySelect.selectedIndex = i;
              match = true;
              break;
            }
          }
          if (!match) deitySelect.value = "General";
        }
        if (priceInput) priceInput.value = String(p.price);
        if (activeInput) activeInput.checked = p.is_active;
        if (errDiv) errDiv.classList.add("hidden");

        modalEditPooja?.classList.remove("hidden");
        nameEnInput?.focus();
      }

      function openDeletePoojaModal(id: string) {
        const p = allPoojas.find(item => item.id === id);
        if (!p) return;
        deletingPoojaTarget = p;

        const idInput = document.getElementById("del-pooja-id") as HTMLInputElement;
        const codeEl = document.getElementById("del-pooja-code");
        const nameEl = document.getElementById("del-pooja-name");
        const deityEl = document.getElementById("del-pooja-deity");
        const rateEl = document.getElementById("del-pooja-rate");

        if (idInput) idInput.value = p.id;
        if (codeEl) codeEl.textContent = `#${p.code}`;
        if (nameEl) nameEl.textContent = p.name_ml ? `${p.name_en} (${p.name_ml})` : p.name_en;
        if (deityEl) deityEl.textContent = p.deity_name;
        if (rateEl) rateEl.textContent = `₹${Number(p.price).toFixed(2)}`;

        modalDeletePooja?.classList.remove("hidden");
      }

      function closeAllModals() {
        modalAddPooja?.classList.add("hidden");
        modalEditPooja?.classList.add("hidden");
        modalDeletePooja?.classList.add("hidden");
        deletingPoojaTarget = null;
      }

      // Submit Add Form
      formAddPooja?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById("btn-submit-add-pooja") as HTMLButtonElement;
        const errDiv = document.getElementById("add-pooja-error");

        const code = (document.getElementById("add-pooja-code") as HTMLInputElement).value.trim();
        const name_en = (document.getElementById("add-pooja-name-en") as HTMLInputElement).value.trim();
        const name_ml = (document.getElementById("add-pooja-name-ml") as HTMLInputElement).value.trim();
        const deity_name = (document.getElementById("add-pooja-deity") as HTMLSelectElement).value;
        const price = parseFloat((document.getElementById("add-pooja-price") as HTMLInputElement).value);
        const is_active = (document.getElementById("add-pooja-active") as HTMLInputElement).checked;

        if (!code || !name_en || isNaN(price) || price <= 0) {
          if (errDiv) {
            errDiv.textContent = "Please fill in all required fields with a valid price.";
            errDiv.classList.remove("hidden");
          }
          return;
        }

        const exists = allPoojas.some(p => p.code.toLowerCase() === code.toLowerCase());
        if (exists) {
          if (errDiv) {
            errDiv.textContent = `Pooja code #${code} already exists. Please choose a different code.`;
            errDiv.classList.remove("hidden");
          }
          return;
        }

        if (submitBtn) {
          submitBtn.innerHTML = "<span>⏳ Saving...</span>";
          submitBtn.disabled = true;
        }

        const res = await createPooja({ code, name_en, name_ml, deity_name, price, is_active });
        if (submitBtn) {
          submitBtn.innerHTML = "<span>💾</span><span>Save & Publish Pooja</span>";
          submitBtn.disabled = false;
        }

        if (res.success && res.data) {
          closeAllModals();
          showToast(`New offering '${res.data.name_en}' added successfully!`, "success");
          loadPoojasData();
        } else {
          if (errDiv) {
            errDiv.textContent = res.error || "Failed to create pooja.";
            errDiv.classList.remove("hidden");
          }
        }
      });

      // Submit Edit Form
      formEditPooja?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById("btn-submit-edit-pooja") as HTMLButtonElement;
        const errDiv = document.getElementById("edit-pooja-error");

        const id = (document.getElementById("edit-pooja-id") as HTMLInputElement).value;
        const code = (document.getElementById("edit-pooja-code") as HTMLInputElement).value.trim();
        const name_en = (document.getElementById("edit-pooja-name-en") as HTMLInputElement).value.trim();
        const name_ml = (document.getElementById("edit-pooja-name-ml") as HTMLInputElement).value.trim();
        const deity_name = (document.getElementById("edit-pooja-deity") as HTMLSelectElement).value;
        const price = parseFloat((document.getElementById("edit-pooja-price") as HTMLInputElement).value);
        const is_active = (document.getElementById("edit-pooja-active") as HTMLInputElement).checked;

        if (!id || !code || !name_en || isNaN(price) || price <= 0) {
          if (errDiv) {
            errDiv.textContent = "Please fill in all required fields with a valid price.";
            errDiv.classList.remove("hidden");
          }
          return;
        }

        const duplicate = allPoojas.some(p => p.id !== id && p.code.toLowerCase() === code.toLowerCase());
        if (duplicate) {
          if (errDiv) {
            errDiv.textContent = `Pooja code #${code} is already assigned to another offering.`;
            errDiv.classList.remove("hidden");
          }
          return;
        }

        if (submitBtn) {
          submitBtn.innerHTML = "<span>⏳ Updating...</span>";
          submitBtn.disabled = true;
        }

        const res = await updatePooja(id, { code, name_en, name_ml, deity_name, price, is_active });
        if (submitBtn) {
          submitBtn.innerHTML = "<span>💾</span><span>Update Offering Details</span>";
          submitBtn.disabled = false;
        }

        if (res.success && res.data) {
          closeAllModals();
          showToast(`Offering '${res.data.name_en}' updated successfully!`, "success");
          loadPoojasData();
        } else {
          if (errDiv) {
            errDiv.textContent = res.error || "Failed to update pooja.";
            errDiv.classList.remove("hidden");
          }
        }
      });

      // Confirm Deactivate
      btnConfirmDeactivatePooja?.addEventListener("click", async () => {
        if (!deletingPoojaTarget) return;
        const id = deletingPoojaTarget.id;
        const name = deletingPoojaTarget.name_en;

        const btn = btnConfirmDeactivatePooja as HTMLButtonElement;
        btn.innerHTML = "<span>⏳ Deactivating...</span>";
        btn.disabled = true;

        const res = await deletePooja(id, false);
        btn.innerHTML = "<span>⏸️</span><span>Deactivate Only (നിർജ്ജീവമാക്കുക - ശുപാർശ ചെയ്യുന്നത്)</span>";
        btn.disabled = false;

        if (res.success) {
          closeAllModals();
          showToast(`Offering '${name}' deactivated successfully.`, "info");
          loadPoojasData();
        } else {
          showToast(res.error || "Failed to deactivate pooja.", "error");
        }
      });

      // Confirm Permanent Delete
      btnConfirmPermanentDeletePooja?.addEventListener("click", async () => {
        if (!deletingPoojaTarget) return;
        const id = deletingPoojaTarget.id;
        const name = deletingPoojaTarget.name_en;

        const btn = btnConfirmPermanentDeletePooja as HTMLButtonElement;
        btn.innerHTML = "<span>⏳ Deleting...</span>";
        btn.disabled = true;

        const res = await deletePooja(id, true);
        btn.innerHTML = "<span>🗑️</span><span>Permanently Delete from Database (പൂർണ്ണമായി നീക്കുക)</span>";
        btn.disabled = false;

        if (res.success) {
          closeAllModals();
          showToast(`Offering '${name}' permanently removed from database.`, "error");
          loadPoojasData();
        } else {
          showToast(res.error || "Failed to permanently delete pooja.", "error");
        }
      });

      // Modal close listeners
      document.querySelectorAll(".modal-close-btn").forEach(btn => {
        btn.addEventListener("click", closeAllModals);
      });

      [modalAddPooja, modalEditPooja, modalDeletePooja].forEach(modal => {
        modal?.addEventListener("click", (e) => {
          if (e.target === modal) closeAllModals();
        });
      });

      // Search, Filter & Actions
      poojaSearchInput?.addEventListener("input", applyPoojaFilters);
      poojaDeityFilter?.addEventListener("change", applyPoojaFilters);
      poojaStatusFilter?.addEventListener("change", applyPoojaFilters);
      poojaSortBy?.addEventListener("change", applyPoojaFilters);
      btnRefreshPoojas?.addEventListener("click", loadPoojasData);
      btnOpenAddPoojaModal?.addEventListener("click", openAddPoojaModal);

      // Export Pooja Catalog to Excel
      btnExportPoojaCatalog?.addEventListener("click", () => {
        if (allPoojas.length === 0) {
          showToast("No poojas available to export.", "error");
          return;
        }

        const exportData = allPoojas.map(p => ({
          "Code": p.code,
          "Offering Name (English)": p.name_en,
          "Offering Name (Malayalam)": p.name_ml || "",
          "Presiding Deity": p.deity_name,
          "Rate (INR)": p.price,
          "Status": p.is_active ? "Active" : "Inactive",
          "Last Updated": p.updated_at ? new Date(p.updated_at).toLocaleString("en-IN") : ""
        }));

        const worksheet = XLSX.utils.json_to_sheet(exportData);
        const workbook = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(workbook, worksheet, "Pooja Rate List");
        XLSX.writeFile(workbook, `Thirumarady_Temple_Pooja_Catalog_${new Date().toISOString().split("T")[0]}.xlsx`);
        showToast("Pooja rate card exported to Excel.", "success");
      });

    </script>
  </body>
</html>
