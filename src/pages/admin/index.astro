      // Chart 3: Top 10 High-Revenue Poojas (Horizontal Bar)
      function renderTopPoojasChart() {
        const canvas = document.getElementById("chart-top-poojas") as HTMLCanvasElement;
        if (!canvas) return;

        const poojaMap: { [name: string]: { rev: number; qty: number } } = {};

        filteredBills.forEach(b => {
