      // Render Transaction Ledger Table
      function renderTable() {
        if (!tableBody) return;

        if (filteredBills.length === 0) {
          tableBody.innerHTML = `
            <tr>
              <td colspan="9" class="py-12 text-center text-stone-400 italic">
                No receipts found matching the selected filter criteria.
              </td>
            </tr>
          `;
          if (paginationInfo) paginationInfo.textContent = "0 of 0 records";
          return;
        }

        const totalPages = Math.ceil(filteredBills.length / pageSize) || 1;
        if (currentPage > totalPages) currentPage = totalPages;

        const startIndex = (currentPage - 1) * pageSize;
        const endIndex = Math.min(startIndex + pageSize, filteredBills.length);
        const pageBills = filteredBills.slice(startIndex, endIndex);

        tableBody.innerHTML = "";

        pageBills.forEach(bill => {
          const row = document.createElement("tr");
          row.className = "hover:bg-amber-50/40 transition-colors border-b border-stone-100 group";

          const itemsCount = (bill.bill_items || []).length;
          const itemsSummary = (bill.bill_items || []).map(i => `${i.pooja_name} (x${i.quantity})`).join(", ");

          // Payment mode badge
          const payBadge = bill.payment_mode === "CASH" 
            ? `<span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold text-[10px]">CASH</span>`
            : `<span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 font-bold text-[10px]">${bill.payment_mode}</span>`;

          const dt = new Date(bill.created_at);
          const timeFormatted = dt.toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" });
          const dateFormatted = bill.pooja_date || dt.toISOString().split("T")[0];

          row.innerHTML = `
            <td class="py-3 px-4 font-mono font-bold text-amber-900 whitespace-nowrap">
              ${bill.bill_number}
            </td>
            <td class="py-3 px-4 whitespace-nowrap text-stone-600">
              <span class="block font-semibold text-stone-900">${dateFormatted}</span>
              <span class="text-[10px] text-stone-400">${timeFormatted}</span>
            </td>
            <td class="py-3 px-4 font-bold text-stone-900">
              ${bill.devotee_name}
            </td>
            <td class="py-3 px-4 font-malayalam text-stone-700">
              ${bill.star_name}
            </td>
            <td class="py-3 px-4 max-w-xs">
              <span class="inline-block px-1.5 py-0.5 rounded bg-stone-100 font-bold text-[10px] text-stone-700 mr-1.5">
                ${itemsCount} pooja${itemsCount > 1 ? "s" : ""}
              </span>
              <span class="text-stone-500 truncate inline-block max-w-[200px] align-middle" title="${itemsSummary}">
                ${itemsSummary}
              </span>
            </td>
            <td class="py-3 px-4 text-center whitespace-nowrap">
              ${payBadge}
            </td>
            <td class="py-3 px-4 text-[11px] text-stone-500 whitespace-nowrap">
              ${bill.counter_id === 'ONLINE' ? '<span class="inline-block px-1.5 py-0.5 rounded bg-blue-100 text-blue-800 font-bold text-[10px]">🌐 ONLINE</span>' : `<span class="font-bold text-stone-700 block">${bill.counter_id}</span>`}
              <span class="block truncate max-w-[150px]" title="${bill.billed_by || 'Operator'}">${bill.billed_by || "Operator"}</span>
            </td>
            <td class="py-3 px-4 text-right font-serif font-black text-amber-900 text-sm whitespace-nowrap">
              ₹${Number(bill.total_amount).toLocaleString("en-IN")}
            </td>
            <td class="py-3 px-3 text-center no-print whitespace-nowrap">
              <button
                type="button"
                class="view-breakdown-btn px-2 py-1 rounded bg-stone-100 hover:bg-amber-100 text-stone-700 hover:text-amber-900 text-[10px] font-bold transition-colors"
                data-id="${bill.id}"
              >
                Expand ↓
              </button>
            </td>
          `;

          // Expandable Line Items Details Row
          const detailRow = document.createElement("tr");
          detailRow.id = `detail-${bill.id}`;
          detailRow.className = "hidden bg-stone-50/80 border-b border-stone-200 text-xs";
          
          let lineItemsHtml = "";
          (bill.bill_items || []).forEach((item, i) => {
            lineItemsHtml += `
              <div class="flex items-center justify-between py-1.5 border-b border-stone-200/60 last:border-0 text-xs">
                <div class="flex items-center space-x-2">
                  <span class="w-5 h-5 rounded-full bg-amber-500/10 text-amber-800 font-bold text-[10px] flex items-center justify-center">${i + 1}</span>
                  <div>
                    <span class="font-bold text-stone-900">${item.pooja_name}</span>
                    <span class="text-[10px] text-stone-500 ml-1">(${item.deity_name})</span>
                  </div>
                </div>
                <div class="font-mono text-stone-700">
                  <span>${item.quantity} × ₹${item.unit_price}</span>
                  <span class="ml-3 font-bold text-amber-900">= ₹${item.subtotal}</span>
                </div>
              </div>
            `;
          });

          detailRow.innerHTML = `
            <td colspan="9" class="p-4 pl-12">
              <div class="p-3.5 rounded-xl bg-white border border-stone-200 shadow-sm max-w-2xl">
                <div class="flex items-center justify-between pb-2 mb-2 border-b border-stone-200 text-xs">
                  <span class="font-bold text-stone-900 uppercase tracking-wider text-[11px]">
                    Itemized Pooja Breakdown (Bill: ${bill.bill_number})
                  </span>
                  <span class="font-mono font-bold text-amber-900">
                    Grand Total: ₹${bill.total_amount}
                  </span>
                </div>
                <div class="space-y-1">
                  ${lineItemsHtml || "<p class='text-stone-400 italic text-xs'>No line item records.</p>"}
                </div>
              </div>
            </td>
          `;

          tableBody.appendChild(row);
          tableBody.appendChild(detailRow);
        });

        // Add toggle listeners
        tableBody.querySelectorAll(".view-breakdown-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            const id = btn.getAttribute("data-id");
            const targetRow = document.getElementById(`detail-${id}`);
            if (targetRow) {
              const isHidden = targetRow.classList.contains("hidden");
              if (isHidden) {
                targetRow.classList.remove("hidden");
                btn.textContent = "Collapse ↑";
              } else {
                targetRow.classList.add("hidden");
                btn.textContent = "Expand ↓";
              }
            }
          });
        });

        // Pagination UI update
        if (paginationInfo) {
          paginationInfo.textContent = `Showing ${startIndex + 1} to ${endIndex} of ${filteredBills.length} records`;
        }
        if (currentPageNum) currentPageNum.textContent = String(currentPage);
        if (btnPrevPage) btnPrevPage.disabled = currentPage <= 1;
        if (btnNextPage) btnNextPage.disabled = currentPage >= totalPages;
      }

      btnPrevPage?.addEventListener("click", () => {
        if (currentPage > 1) {
          currentPage--;
          renderTable();
        }
      });

      btnNextPage?.addEventListener("click", () => {
        const totalPages = Math.ceil(filteredBills.length / pageSize) || 1;
        if (currentPage < totalPages) {
          currentPage++;
          renderTable();
        }
      });

      // =========================================================================
      // EXCEL EXPORT HANDLER (.xlsx)
      // =========================================================================
      btnExportExcel?.addEventListener("click", () => {
        if (filteredBills.length === 0) {
          alert("No records to export.");
          return;
        }

        // Sheet 1: Summary of Bills
        const summaryData = filteredBills.map(b => ({
          "Bill Number": b.bill_number,
          "Date": b.pooja_date || b.created_at.split("T")[0],
          "Time (IST)": new Date(b.created_at).toLocaleTimeString("en-IN"),
          "Devotee Name": b.devotee_name,
          "Birth Star (Nakshatra)": b.star_name,
          "Gothram": b.gothram || "",
          "Payment Mode": b.payment_mode,
          "Counter Machine": b.counter_id,
          "Billed By": b.billed_by || "Operator",
          "Total Amount (INR)": Number(b.total_amount),
          "Items Count": (b.bill_items || []).length
        }));

        // Sheet 2: Itemized Line Items
        const itemizedData: any[] = [];
        filteredBills.forEach(b => {
          (b.bill_items || []).forEach(item => {
            itemizedData.push({
              "Bill Number": b.bill_number,
              "Date": b.pooja_date || b.created_at.split("T")[0],
              "Devotee Name": b.devotee_name,
              "Offering Name": item.pooja_name,
              "Deity": item.deity_name,
              "Quantity": item.quantity,
              "Unit Price (INR)": Number(item.unit_price),
              "Subtotal (INR)": Number(item.subtotal),
              "Payment Mode": b.payment_mode
            });
          });
        });

        // Sheet 3: Pooja-wise Totals
        const poojaAggMap: { [name: string]: { deity: string; qty: number; rev: number } } = {};
        filteredBills.forEach(b => {
          (b.bill_items || []).forEach(item => {
            const name = item.pooja_name;
            if (!poojaAggMap[name]) poojaAggMap[name] = { deity: item.deity_name, qty: 0, rev: 0 };
            poojaAggMap[name].qty += Number(item.quantity) || 1;
            poojaAggMap[name].rev += Number(item.subtotal) || 0;
          });
        });

        const poojaAggData = Object.entries(poojaAggMap).map(([name, data]) => ({
          "Offering Name": name,
          "Associated Deity": data.deity,
          "Total Quantity Sold": data.qty,
          "Total Revenue (INR)": data.rev
        })).sort((a, b) => b["Total Revenue (INR)"] - a["Total Revenue (INR)"]);

        // Create workbook
        const wb = XLSX.utils.book_new();

        const ws1 = XLSX.utils.json_to_sheet(summaryData);
        const ws2 = XLSX.utils.json_to_sheet(itemizedData);
        const ws3 = XLSX.utils.json_to_sheet(poojaAggData);

        XLSX.utils.book_append_sheet(wb, ws1, "Bills Summary");
        XLSX.utils.book_append_sheet(wb, ws2, "Itemized Poojas");
        XLSX.utils.book_append_sheet(wb, ws3, "Pooja Aggregates");

        const from = filterDateFrom?.value || "start";
        const to = filterDateTo?.value || "end";
        const fileName = `Thirumarady_Temple_Billing_Report_${from}_to_${to}.xlsx`;

        XLSX.writeFile(wb, fileName);
      });

      // =========================================================================
      // PDF AUDIT REPORT / PRINT HANDLER
      // =========================================================================
      btnExportPdf?.addEventListener("click", () => {
        updatePrintReport();
        const from = filterDateFrom?.value || "All";
        const to = filterDateTo?.value || "Time";
        const originalTitle = document.title;
        document.title = `Thirumarady_Temple_Audit_Statement_${from}_to_${to}`;
        window.print();
        setTimeout(() => {
          document.title = originalTitle;
        }, 1500);
      });

      function updatePrintReport() {
        const from = filterDateFrom?.value || "Start";
        const to = filterDateTo?.value || "End";
        const counter = filterCounter?.value || "All Counters";

        const pRange = document.getElementById("print-date-range");
        const pCounter = document.getElementById("print-counter");
        const pTime = document.getElementById("print-timestamp");
        const pOfficer = document.getElementById("print-officer");

        if (pRange) pRange.textContent = `${from} to ${to}`;
        if (pCounter) pCounter.textContent = counter;
        if (pTime) pTime.textContent = new Date().toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" });
        if (pOfficer && currentUser) pOfficer.textContent = currentUser.full_name;

        // KPI metrics for print
        let total = 0;
        let cash = 0;
        let upi = 0;
        const poojaMap: { [name: string]: { deity: string; qty: number; rev: number } } = {};

        filteredBills.forEach(b => {
          const amt = Number(b.total_amount) || 0;
          total += amt;
          const mode = (b.payment_mode || "").toUpperCase();
          if (mode === "CASH") cash += amt;
          else if (mode === "UPI") upi += amt;

          (b.bill_items || []).forEach(item => {
            const name = item.pooja_name;
            if (!poojaMap[name]) poojaMap[name] = { deity: item.deity_name, qty: 0, rev: 0 };
            poojaMap[name].qty += Number(item.quantity) || 1;
            poojaMap[name].rev += Number(item.subtotal) || 0;
          });
        });

        const printBills = document.getElementById("print-kpi-bills");
        const printCash = document.getElementById("print-kpi-cash");
        const printUpi = document.getElementById("print-kpi-upi");
        const printTotal = document.getElementById("print-kpi-total");

        if (printBills) printBills.textContent = `${filteredBills.length} bills`;
        if (printCash) printCash.textContent = `₹${cash.toLocaleString("en-IN")}`;
        if (printUpi) printUpi.textContent = `₹${upi.toLocaleString("en-IN")}`;
        if (printTotal) printTotal.textContent = `₹${total.toLocaleString("en-IN")}`;

        // 1. Populate pooja summary table in print
        const printPoojaBody = document.getElementById("print-pooja-summary-body");
        if (printPoojaBody) {
          const sorted = Object.entries(poojaMap).sort((a, b) => b[1].rev - a[1].rev);
          let rowsHtml = "";
          sorted.forEach(([name, d], idx) => {
            rowsHtml += `
              <tr class="even:bg-stone-50/50">
                <td class="p-2 border border-stone-300 text-center">${idx + 1}</td>
                <td class="p-2 border border-stone-300 font-bold" style="font-family: 'Noto Sans Malayalam', 'Nirmala UI', sans-serif;">${name}</td>
                <td class="p-2 border border-stone-300">${d.deity}</td>
                <td class="p-2 border border-stone-300 text-center font-bold">${d.qty}</td>
                <td class="p-2 border border-stone-300 text-right font-bold">₹${d.rev.toLocaleString("en-IN")}</td>
              </tr>
            `;
          });
          printPoojaBody.innerHTML = rowsHtml || `<tr><td colspan="5" class="p-4 text-center">No poojas booked in this period.</td></tr>`;
        }

        // 2. Populate devotee receipts audit register in print
        const printReceiptsBody = document.getElementById("print-receipts-summary-body");
        if (printReceiptsBody) {
          let receiptsHtml = "";
          filteredBills.forEach((b, idx) => {
            const timeStr = b.created_at
              ? new Date(b.created_at).toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" }) + " " + new Date(b.created_at).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" })
              : (b.pooja_date || "-");
            const itemsStr = (b.bill_items || []).map(i => `${i.pooja_name} (x${i.quantity})`).join(", ") || "General Offering";
            receiptsHtml += `
              <tr class="even:bg-stone-50/50">
                <td class="p-1.5 border border-stone-300 text-center text-stone-500">${idx + 1}</td>
                <td class="p-1.5 border border-stone-300 font-mono font-bold whitespace-nowrap">${b.bill_number}</td>
                <td class="p-1.5 border border-stone-300 text-stone-600 whitespace-nowrap text-[9px]">${timeStr}</td>
                <td class="p-1.5 border border-stone-300 font-bold">${b.devotee_name}</td>
                <td class="p-1.5 border border-stone-300 whitespace-nowrap" style="font-family: 'Noto Sans Malayalam', 'Nirmala UI', sans-serif;">${b.star_name}</td>
                <td class="p-1.5 border border-stone-300 max-w-[200px] truncate" style="font-family: 'Noto Sans Malayalam', 'Nirmala UI', sans-serif;" title="${itemsStr}">${itemsStr}</td>
                <td class="p-1.5 border border-stone-300 text-center font-bold text-[9px]">${b.payment_mode}</td>
                <td class="p-1.5 border border-stone-300 text-right font-mono font-bold">₹${Number(b.total_amount).toLocaleString("en-IN")}</td>
              </tr>
            `;
          });
          printReceiptsBody.innerHTML = receiptsHtml || `<tr><td colspan="8" class="p-3 text-center text-stone-500">No receipts found for selected period.</td></tr>`;
        }
      }
    </script>
  </body>
</html>
