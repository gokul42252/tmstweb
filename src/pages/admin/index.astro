      // Chart 4: Deity-wise Revenue Distribution
      function renderDeityRevenueChart() {
        const canvas = document.getElementById("chart-deity-revenue") as HTMLCanvasElement;
        if (!canvas) return;

        const deityMap: { [deity: string]: number } = {
          "Lord Shiva": 0,
          "Lord Ganapathy": 0,
          "Lord Sastha / Ayyappan": 0,
          "Goddess Parvathi / Bhagavathi": 0,
          "Nagas / Edaprakavu": 0
        };

        filteredBills.forEach(b => {
          (b.bill_items || []).forEach(item => {
            const rawDeity = (item.deity_name || "").toLowerCase();
            const name = (item.pooja_name || "").toLowerCase();
            const sub = Number(item.subtotal) || 0;

            if (rawDeity.includes("ganapathy") || name.includes("ganapathy") || name.includes("karuka") || name.includes("modakam")) {
              deityMap["Lord Ganapathy"] += sub;
            } else if (rawDeity.includes("sastha") || rawDeity.includes("ayyappan") || name.includes("neerajanam") || name.includes("sastha")) {
              deityMap["Lord Sastha / Ayyappan"] += sub;
            } else if (rawDeity.includes("parvathi") || name.includes("bhagavathi") || name.includes("swayamvara")) {
              deityMap["Goddess Parvathi / Bhagavathi"] += sub;
            } else if (rawDeity.includes("serpent") || rawDeity.includes("naga") || name.includes("noor") || name.includes("sarpa")) {
              deityMap["Nagas / Edaprakavu"] += sub;
            } else {
              deityMap["Lord Shiva"] += sub;
            }
          });
        });

        if (chartDeity) chartDeity.destroy();

        chartDeity = new Chart(canvas, {
          type: "polarArea",
          data: {
            labels: Object.keys(deityMap),
            datasets: [
              {
                data: Object.values(deityMap),
                backgroundColor: [
                  "rgba(217, 119, 6, 0.75)",
                  "rgba(239, 68, 68, 0.75)",
                  "rgba(16, 185, 129, 0.75)",
                  "rgba(168, 85, 247, 0.75)",
                  "rgba(14, 165, 233, 0.75)"
                ]
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: "right", labels: { boxWidth: 10, font: { size: 10 } } },
              tooltip: {
                callbacks: {
                  label: (ctx) => `${ctx.label}: ₹${Number(ctx.parsed.r || 0).toLocaleString("en-IN")}`
                }
              }
            }
          }
        });
      }

      // Chart 5: Peak Hours Distribution
      function renderHourlyChart() {
        const canvas = document.getElementById("chart-hourly-distribution") as HTMLCanvasElement;
        if (!canvas) return;

        // Group into 2-hour slots across 24h
        const slots: { [slot: string]: number } = {
          "04:00 - 06:00 (Nirmalyam)": 0,
          "06:00 - 08:00 (Usha Pooja)": 0,
          "08:00 - 10:30 (Ucha Pooja)": 0,
          "10:30 - 17:00 (Afternoon)": 0,
          "17:00 - 19:00 (Deeparadhana)": 0,
          "19:00 - 21:00 (Athazha Pooja)": 0,
          "Night / Other": 0
        };

        filteredBills.forEach(b => {
          if (!b.created_at) return;
          const dt = new Date(b.created_at);
          const hr = dt.getHours();
          const amt = Number(b.total_amount) || 0;

          if (hr >= 4 && hr < 6) slots["04:00 - 06:00 (Nirmalyam)"] += amt;
          else if (hr >= 6 && hr < 8) slots["06:00 - 08:00 (Usha Pooja)"] += amt;
          else if (hr >= 8 && hr < 11) slots["08:00 - 10:30 (Ucha Pooja)"] += amt;
          else if (hr >= 11 && hr < 17) slots["10:30 - 17:00 (Afternoon)"] += amt;
          else if (hr >= 17 && hr < 19) slots["17:00 - 19:00 (Deeparadhana)"] += amt;
          else if (hr >= 19 && hr < 21) slots["19:00 - 21:00 (Athazha Pooja)"] += amt;
          else slots["Night / Other"] += amt;
        });

        if (chartHourly) chartHourly.destroy();

        chartHourly = new Chart(canvas, {
          type: "bar",
          data: {
            labels: Object.keys(slots),
            datasets: [
              {
                label: "Billing Volume (₹)",
                data: Object.values(slots),
                backgroundColor: "#6366f1",
                borderRadius: 4
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: (ctx) => `Revenue: ₹${Number(ctx.parsed.y || 0).toLocaleString("en-IN")}`
                }
              }
            },
            scales: {
              x: { ticks: { font: { size: 9 } } },
              y: {
                ticks: {
                  callback: (val) => "₹" + Number(val).toLocaleString("en-IN")
                }
              }
            }
          }
        });
      }

      // Chart 6: Devotee Birth Stars (Nakshatra)
      function renderStarsChart() {
        const canvas = document.getElementById("chart-star-distribution") as HTMLCanvasElement;
        if (!canvas) return;

        const starMap: { [star: string]: number } = {};

        filteredBills.forEach(b => {
          const star = (b.star_name || "Not Specified").split("-")[0].trim();
