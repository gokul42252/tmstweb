---
import "../../assets/styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Billing Portal | Thirumarady Sri Mahadeva Temple</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Manjari:wght@400;700&family=Noto+Sans+Malayalam:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      @media print {
        @page {
          size: A4 portrait;
          margin: 10mm 12mm 12mm 12mm;
        }

        html, body {
          background-color: #ffffff !important;
          background: #ffffff !important;
          color: #000000 !important;
          font-family: 'Noto Sans Malayalam', 'Nirmala UI', 'Manjari', 'Segoe UI', system-ui, -apple-system, sans-serif !important;
          font-size: 10pt !important;
          margin: 0 !important;
          padding: 0 !important;
          width: 100% !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }

        /* CRUCIAL FIX: Completely hide login, dashboard, charts, tables, headers, footers during print */
        #login-container,
        #dashboard-container,
        header,
        footer,
        nav,
        .no-print {
          display: none !important;
          visibility: hidden !important;
          height: 0 !important;
          max-height: 0 !important;
          margin: 0 !important;
          padding: 0 !important;
          overflow: hidden !important;
          opacity: 0 !important;
        }

        /* Show ONLY the official printable audit report */
        #printable-audit-report,
        .print-only {
          display: block !important;
          visibility: visible !important;
          width: 100% !important;
          max-width: 100% !important;
          margin: 0 !important;
          padding: 0 !important;
          opacity: 1 !important;
        }

        table {
          width: 100% !important;
          border-collapse: collapse !important;
        }

        thead {
          display: table-header-group !important;
        }

        tr {
          break-inside: avoid !important;
          page-break-inside: avoid !important;
        }

        .print-break-inside-avoid,
        .signature-block {
          break-inside: avoid !important;
          page-break-inside: avoid !important;
        }

        .print-shadow-none {
          box-shadow: none !important;
          border: 1px solid #d1d5db !important;
        }
      }

      .print-only {
        display: none;
      }
    </style>
  </head>
  <body class="bg-stone-100 text-stone-900 font-sans min-h-screen flex flex-col antialiased selection:bg-amber-500 selection:text-white">

    <!-- ========================================================================= -->
    <!-- 1. LOGIN SCREEN (Visible when unauthenticated) -->
    <!-- ========================================================================= -->
    <div id="login-container" class="no-print min-h-screen flex items-center justify-center p-4 bg-gradient-to-br from-stone-950 via-stone-900 to-amber-950/80">
      <div class="w-full max-w-md bg-stone-900/90 backdrop-blur-xl border border-amber-500/30 rounded-3xl p-6 sm:p-8 shadow-2xl text-white relative overflow-hidden">
        
        <!-- Golden Decorative Glow -->
        <div class="absolute -top-16 -right-16 w-36 h-36 bg-amber-500/15 rounded-full blur-2xl pointer-events-none"></div>
        <div class="absolute -bottom-16 -left-16 w-36 h-36 bg-amber-600/15 rounded-full blur-2xl pointer-events-none"></div>

        <!-- Logo & Header -->
        <div class="text-center mb-6">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-3xl mb-3 shadow-inner">
            🔱
          </div>
          <h1 class="font-malayalam font-bold text-amber-300 text-lg sm:text-xl leading-tight">
            തിരുമാറാടി ശ്രീ മഹാദേവ ക്ഷേത്രം
          </h1>
          <p class="font-serif font-bold text-white text-base sm:text-lg mt-0.5 tracking-wide">
            Counter Billing Admin Portal
          </p>
          <p class="text-xs text-stone-400 mt-1">
            Poojas Collection, Real-Time Analytics & Audit Reports
          </p>
        </div>

        <!-- Error Alert -->
        <div id="login-error-alert" class="hidden mb-4 p-3 rounded-xl bg-red-950/80 border border-red-500/50 text-red-200 text-xs flex items-center space-x-2">
          <span>⚠️</span>
          <span id="login-error-msg">Invalid credentials. Please verify username and password.</span>
        </div>

        <!-- Login Form -->
        <form id="admin-login-form" class="space-y-4">
          <div>
            <label for="login-username" class="block text-xs font-bold uppercase tracking-wider text-amber-400 mb-1.5">
              Staff Username (ഉപയോക്തൃ നാമം)
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400 text-sm">
                👤
              </span>
              <input
                type="text"
                id="login-username"
                required
                autocomplete="username"
                placeholder="e.g. admin or counter1"
                class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-stone-950 border border-stone-700 text-white placeholder-stone-500 text-sm focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400"
              />
            </div>
          </div>

          <div>
            <label for="login-password" class="block text-xs font-bold uppercase tracking-wider text-amber-400 mb-1.5">
              Staff Password (പാസ്‌വേഡ്)
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400 text-sm">
                🔒
              </span>
              <input
                type="password"
                id="login-password"
                required
                autocomplete="current-password"
                placeholder="••••••••"
                class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-stone-950 border border-stone-700 text-white placeholder-stone-500 text-sm focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400"
              />
            </div>
          </div>

          <button
            type="submit"
            id="login-submit-btn"
            class="w-full mt-2 py-3 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-stone-950 font-bold text-sm tracking-wide shadow-lg shadow-amber-500/20 transition-all flex items-center justify-center space-x-2"
          >
            <span>🔓 Sign In to Admin Portal</span>
          </button>
        </form>

        <!-- Quick Credentials Hint for Temple Administration -->
        <div class="mt-6 pt-5 border-t border-stone-800 text-[11px] text-stone-400">
          <p class="font-bold text-amber-300 mb-1.5 flex items-center gap-1">
            <span>🔑</span>
            <span>Registered Staff Accounts:</span>
          </p>
          <div class="grid grid-cols-2 gap-2 text-[10px]">
            <button
              type="button"
              onclick="fillCredentials('admin', 'admin')"
              class="p-2 rounded-lg bg-stone-950 border border-stone-800 hover:border-amber-500/50 text-left transition-colors"
            >
              <span class="block font-bold text-stone-200">Temple Treasurer (ട്രഷറർ)</span>
              <span class="text-stone-400">User: admin / admin</span>
            </button>
            <button
              type="button"
              onclick="fillCredentials('counter1', '123')"
              class="p-2 rounded-lg bg-stone-950 border border-stone-800 hover:border-amber-500/50 text-left transition-colors"
            >
              <span class="block font-bold text-stone-200">Counter Staff 1</span>
              <span class="text-stone-400">User: counter1 / 123</span>
            </button>
          </div>
        </div>

        <div class="mt-5 text-center">
          <a href="/" class="text-xs text-amber-400/80 hover:text-amber-300 transition-colors inline-flex items-center gap-1">
            <span>← Back to Public Website</span>
          </a>
        </div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 2. MAIN DASHBOARD APPLICATION SCREEN (Visible when authenticated) -->
    <!-- ========================================================================= -->
    <div id="dashboard-container" class="no-print hidden min-h-screen flex-col bg-stone-100 text-stone-900">
      
      <!-- Top Navigation & Profile Bar -->
      <header class="no-print sticky top-0 z-40 bg-stone-950 text-white border-b-2 border-amber-600 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between h-16 gap-3">
            
            <!-- Left: Temple Brand & Portal Title -->
            <div class="flex items-center space-x-3 min-w-0">
              <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-xl flex-shrink-0">
                🔱
              </div>
              <div class="min-w-0">
                <div class="flex items-center space-x-2">
                  <h1 class="font-serif font-black text-sm sm:text-base text-white truncate">
                    Thirumarady Mahadeva Temple
                  </h1>
                  <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500 text-stone-950 uppercase">
                    Admin Portal
                  </span>
                </div>
                <div class="flex items-center space-x-2 text-[10px] sm:text-xs text-stone-400">
                  <span class="font-malayalam text-amber-300">ക്ഷേത്ര ബില്ലിംഗ് പോർട്ടൽ</span>
                  <span>•</span>
                  <span class="inline-flex items-center gap-1 text-emerald-400 font-semibold">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Supabase Live</span>
                  </span>
                </div>
              </div>
            </div>

            <!-- Right: Action Buttons & User Menu -->
            <div class="flex items-center space-x-2 sm:space-x-3 flex-shrink-0">
              <!-- Live Data Refresh -->
              <button
                id="btn-refresh"
                title="Refresh latest bills from Supabase"
                class="px-2.5 sm:px-3 py-1.5 rounded-lg bg-stone-900 hover:bg-stone-800 border border-stone-700 text-amber-300 font-semibold text-xs transition-colors flex items-center gap-1.5"
              >
                <span id="refresh-icon" class="inline-block transition-transform">🔄</span>
                <span class="hidden md:inline">Refresh</span>
              </button>

              <!-- Export Excel -->
              <button
                id="btn-export-excel"
                title="Export filtered collection to Excel (.xlsx)"
                class="px-2.5 sm:px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm"
              >
                <span>📊</span>
                <span class="hidden sm:inline">Export Excel</span>
              </button>

              <!-- Export / Print PDF -->
              <button
                id="btn-export-pdf"
                title="Print or Save Official Audit PDF Report"
                class="px-2.5 sm:px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-stone-950 font-bold text-xs transition-colors flex items-center gap-1.5 shadow-sm"
              >
                <span>🖨️</span>
                <span class="hidden sm:inline">PDF Audit Report</span>
              </button>

              <!-- User Badge & Logout -->
              <div class="flex items-center space-x-2 pl-2 border-l border-stone-800">
                <div class="text-right hidden lg:block">
                  <span id="user-display-name" class="block text-xs font-bold text-stone-200">Temple Treasurer (ട്രഷറർ)</span>
                  <span id="user-role-badge" class="block text-[10px] text-amber-400 font-mono font-semibold">TREASURER</span>
                </div>
                <button
                  id="btn-logout"
                  title="Logout from Admin Portal"
                  class="p-2 rounded-lg bg-stone-900 hover:bg-red-950 hover:text-red-300 text-stone-400 border border-stone-800 text-xs transition-colors"
                >
                  🚪
                </button>
              </div>

            </div>

          </div>
        </div>
      </header>

      <!-- Main Dashboard Content Area -->
      <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- ===================================================================== -->
        <!-- FILTER TOOLBAR (Quick Presets, Date Inputs, Counter, Payment, Search) -->
        <!-- ===================================================================== -->
        <section class="no-print bg-white rounded-2xl p-4 sm:p-5 border border-stone-200 shadow-sm space-y-4">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-3 border-b border-stone-100">
            <div>
              <h2 class="text-base sm:text-lg font-serif font-bold text-stone-900">
                Collection Analytics & Report Filters
              </h2>
              <p class="text-xs text-stone-500">
                Filter pooja revenue data uploaded from counter billing machines.
              </p>
            </div>

            <!-- Quick Date Filter Preset Pills -->
            <div class="flex flex-wrap items-center gap-1.5">
              <button type="button" class="date-preset-btn active px-3 py-1 rounded-lg text-xs font-bold bg-amber-600 text-white transition-colors" data-preset="today">
                Today
              </button>
              <button type="button" class="date-preset-btn px-3 py-1 rounded-lg text-xs font-bold bg-stone-100 hover:bg-stone-200 text-stone-700 transition-colors" data-preset="yesterday">
                Yesterday
              </button>
              <button type="button" class="date-preset-btn px-3 py-1 rounded-lg text-xs font-bold bg-stone-100 hover:bg-stone-200 text-stone-700 transition-colors" data-preset="week">
                This Week (7D)
              </button>
              <button type="button" class="date-preset-btn px-3 py-1 rounded-lg text-xs font-bold bg-stone-100 hover:bg-stone-200 text-stone-700 transition-colors" data-preset="month">
                This Month
              </button>
              <button type="button" class="date-preset-btn px-3 py-1 rounded-lg text-xs font-bold bg-stone-100 hover:bg-stone-200 text-stone-700 transition-colors" data-preset="all">
                All Time
              </button>
            </div>
          </div>

          <!-- Filter Controls Row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
            
            <!-- From Date -->
            <div>
              <label for="filter-date-from" class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 mb-1">
                From Date
              </label>
              <input
                type="date"
                id="filter-date-from"
                class="w-full px-3 py-2 rounded-xl bg-stone-50 border border-stone-300 text-stone-900 text-xs focus:outline-none focus:border-amber-500"
              />
            </div>

            <!-- To Date -->
            <div>
              <label for="filter-date-to" class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 mb-1">
                To Date
              </label>
              <input
                type="date"
                id="filter-date-to"
                class="w-full px-3 py-2 rounded-xl bg-stone-50 border border-stone-300 text-stone-900 text-xs focus:outline-none focus:border-amber-500"
              />
            </div>

            <!-- Counter Selector -->
            <div>
              <label for="filter-counter" class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 mb-1">
                Counter Machine
              </label>
              <select
                id="filter-counter"
                class="w-full px-3 py-2 rounded-xl bg-stone-50 border border-stone-300 text-stone-900 text-xs focus:outline-none focus:border-amber-500"
              >
                <option value="ALL">All Counters</option>
                <option value="COUNTER-1">COUNTER-1 (Main)</option>
                <option value="COUNTER-2">COUNTER-2</option>
                <option value="ONLINE">ONLINE (Web Portal & UPI)</option>
              </select>
            </div>

            <!-- Payment Mode Selector -->
            <div>
              <label for="filter-payment-mode" class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 mb-1">
                Payment Mode
              </label>
              <select
                id="filter-payment-mode"
                class="w-full px-3 py-2 rounded-xl bg-stone-50 border border-stone-300 text-stone-900 text-xs focus:outline-none focus:border-amber-500"
              >
                <option value="ALL">All Payments (Cash + UPI + Card)</option>
                <option value="CASH">CASH Only</option>
                <option value="UPI">UPI / QR Code Only</option>
                <option value="CARD">CARD Only</option>
              </select>
            </div>

            <!-- Live Search -->
            <div>
              <label for="filter-search" class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 mb-1">
                Search Devotee / Bill / Star
              </label>
              <input
                type="text"
                id="filter-search"
                placeholder="Search..."
                class="w-full px-3 py-2 rounded-xl bg-stone-50 border border-stone-300 text-stone-900 text-xs focus:outline-none focus:border-amber-500"
              />
            </div>

          </div>
        </section>

        <!-- ===================================================================== -->
        <!-- KPI METRICS SUMMARY CARDS (Top Overview) -->
        <!-- ===================================================================== -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
          
          <!-- Total Collection -->
          <div class="p-5 rounded-2xl bg-white border border-stone-200 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-stone-500 mb-2">
              <span class="text-xs font-bold uppercase tracking-wider">Total Collection</span>
              <span class="w-8 h-8 rounded-lg bg-amber-50 text-amber-700 flex items-center justify-center font-bold text-sm">💰</span>
            </div>
            <div>
              <div id="kpi-total-revenue" class="text-2xl sm:text-3xl font-serif font-black text-amber-950">
                ₹0
              </div>
              <div class="text-[11px] text-stone-500 mt-1 flex items-center justify-between">
                <span>Receipts Issued:</span>
                <span id="kpi-total-bills" class="font-bold text-stone-800">0 bills</span>
              </div>
            </div>
          </div>

          <!-- Cash Collected -->
          <div class="p-5 rounded-2xl bg-white border border-emerald-200/80 shadow-sm flex flex-col justify-between bg-emerald-50/20">
            <div class="flex items-center justify-between text-emerald-800 mb-2">
              <span class="text-xs font-bold uppercase tracking-wider">Cash Collection</span>
              <span class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm">💵</span>
            </div>
            <div>
              <div id="kpi-cash-total" class="text-2xl sm:text-3xl font-serif font-black text-emerald-950">
                ₹0
              </div>
              <div class="text-[11px] text-emerald-800 mt-1 flex items-center justify-between">
                <span>Cash Share:</span>
                <span id="kpi-cash-percent" class="font-bold">0%</span>
              </div>
            </div>
          </div>

          <!-- UPI Collected -->
          <div class="p-5 rounded-2xl bg-white border border-blue-200/80 shadow-sm flex flex-col justify-between bg-blue-50/20">
            <div class="flex items-center justify-between text-blue-800 mb-2">
              <span class="text-xs font-bold uppercase tracking-wider">UPI / QR Digital</span>
              <span class="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm">📱</span>
            </div>
            <div>
              <div id="kpi-upi-total" class="text-2xl sm:text-3xl font-serif font-black text-blue-950">
                ₹0
              </div>
              <div class="text-[11px] text-blue-800 mt-1 flex items-center justify-between">
                <span>UPI Share:</span>
                <span id="kpi-upi-percent" class="font-bold">0%</span>
              </div>
            </div>
          </div>

          <!-- Poojas Performed -->
          <div class="p-5 rounded-2xl bg-white border border-stone-200 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-stone-500 mb-2">
              <span class="text-xs font-bold uppercase tracking-wider">Offerings Booked</span>
              <span class="w-8 h-8 rounded-lg bg-amber-50 text-amber-700 flex items-center justify-center font-bold text-sm">🥥</span>
            </div>
            <div>
              <div id="kpi-poojas-count" class="text-2xl sm:text-3xl font-serif font-black text-stone-900">
                0
              </div>
              <div class="text-[11px] text-stone-500 mt-1 flex items-center justify-between">
                <span>Distinct Poojas:</span>
                <span id="kpi-distinct-poojas" class="font-bold text-stone-800">0</span>
              </div>
            </div>
          </div>

          <!-- Average Bill Value -->
          <div class="p-5 rounded-2xl bg-white border border-stone-200 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between text-stone-500 mb-2">
              <span class="text-xs font-bold uppercase tracking-wider">Avg. Devotee Bill</span>
              <span class="w-8 h-8 rounded-lg bg-stone-100 text-stone-700 flex items-center justify-center font-bold text-sm">📊</span>
            </div>
            <div>
              <div id="kpi-avg-bill" class="text-2xl sm:text-3xl font-serif font-black text-stone-900">
                ₹0
              </div>
              <div class="text-[11px] text-stone-500 mt-1 flex items-center justify-between">
                <span>Avg. Items/Bill:</span>
                <span id="kpi-avg-items" class="font-bold text-stone-800">0</span>
              </div>
            </div>
          </div>

        </section>

        <!-- ===================================================================== -->
        <!-- PICTORIAL REPRESENTATION & ANALYTICAL CHARTS GRID -->
        <!-- ===================================================================== -->
        <section class="space-y-6">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-xl font-serif font-bold text-stone-900 flex items-center gap-2">
                <span>📊</span>
                <span>Visual Pictorial Analysis & Revenue Trends</span>
              </h2>
              <p class="text-xs text-stone-500">
                Graphical representation of daily cashflows, deity breakdown, top vazhipadu, and hourly trends.
              </p>
            </div>
            <span class="text-xs font-mono font-semibold text-amber-800 bg-amber-100 px-2.5 py-1 rounded-full">
              Chart.js Interactive
            </span>
          </div>

          <!-- Charts Row 1: Daily Revenue Trend (8 cols) + Payment Mode Donut (4 cols) -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Chart 1: Daily Timeline Trend -->
            <div class="lg:col-span-8 p-5 rounded-2xl bg-white border border-stone-200 shadow-sm flex flex-col">
              <div class="flex items-center justify-between mb-4 pb-2 border-b border-stone-100">
                <div>
                  <h3 class="font-bold text-stone-900 text-sm sm:text-base">
                    Daily Collection Trend (CASH vs UPI)
                  </h3>
                  <p class="text-[11px] text-stone-500">Revenue trajectory over the selected period</p>
                </div>
                <span class="text-xs font-mono font-bold text-stone-600 bg-stone-100 px-2 py-0.5 rounded">
                  Timeline
                </span>
              </div>
              <div class="relative flex-1 min-h-[280px]">
                <canvas id="chart-daily-revenue"></canvas>
              </div>
            </div>

            <!-- Chart 2: Payment Mode Donut -->
            <div class="lg:col-span-4 p-5 rounded-2xl bg-white border border-stone-200 shadow-sm flex flex-col">
              <div class="flex items-center justify-between mb-4 pb-2 border-b border-stone-100">
                <div>
                  <h3 class="font-bold text-stone-900 text-sm sm:text-base">
                    Payment Mode Share
                  </h3>
                  <p class="text-[11px] text-stone-500">Cash vs UPI digital split</p>
                </div>
                <span class="text-xs font-mono font-bold text-stone-600 bg-stone-100 px-2 py-0.5 rounded">
                  Ratio
                </span>
              </div>
