---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/UI/Button.astro";
import { TEMPLE_INFO } from "../data/templeData";
---

<BaseLayout
  title="Contact & Temple Helpline | Thirumarady Sri Mahadeva Temple"
  description="Contact Thirumarady Sri Mahadeva Temple Devaswom office, Melshanthi, pooja enquiries, emergency contacts, and devotee helpline."
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-stone-950 via-stone-900 to-stone-950 text-white py-16 sm:py-20 border-b border-amber-600/30 text-center">
    <div class="container">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-semibold mb-3 border border-amber-500/30">
        <span>📞</span>
        <span>ബന്ധപ്പെടുക & അന്വേഷണങ്ങൾ</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-serif font-black text-white mb-4">
        Temple Contacts & Helpline
      </h1>
      <p class="text-stone-300 text-base sm:text-lg max-w-2xl mx-auto font-light">
        Reach out to the Devaswom office for pooja bookings, festival queries, or devotee accommodation guidance.
      </p>
    </div>
  </section>

  <!-- Contact Cards & Enquiry Form -->
  <section class="py-16 sm:py-20 bg-stone-50">
    <div class="container max-w-5xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        <!-- Contact Info (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          <div class="p-6 rounded-3xl bg-white border border-stone-200 shadow-sm space-y-4">
            <h3 class="text-xl font-serif font-bold text-stone-900 pb-3 border-b border-stone-100">
              Devaswom Office
            </h3>

            <div class="space-y-3 text-sm text-stone-700">
              <div class="flex items-start space-x-3">
                <span class="text-lg">📍</span>
                <div>
                  <span class="font-bold text-stone-900 block">Address</span>
                  <span>Thirumarady Sri Mahadeva Temple, Piravom – Koothattukulam Road, Thirumarady P.O., Ernakulam, Kerala - 686662</span>
                </div>
              </div>

              <div class="flex items-start space-x-3">
                <span class="text-lg">📞</span>
                <div>
                  <span class="font-bold text-stone-900 block">Temple Office Helpline</span>
                  <a href="tel:+914852877300" class="text-amber-800 font-mono font-bold hover:underline">0485-2877300</a>
                </div>
              </div>

              <div class="flex items-start space-x-3">
                <span class="text-lg">✉️</span>
                <div>
                  <span class="font-bold text-stone-900 block">Devaswom Email</span>
                  <a href="mailto:devaswom@thirumaradytemple.org" class="text-amber-800 hover:underline">devaswom@thirumaradytemple.org</a>
                </div>
              </div>

              <div class="flex items-start space-x-3">
                <span class="text-lg">🕒</span>
                <div>
                  <span class="font-bold text-stone-900 block">Counter Hours</span>
                  <span>Morning: 06:00 AM – 10:30 AM<br />Evening: 05:00 PM – 07:45 PM</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Devotee Enquiry Form (7 cols) -->
        <div class="lg:col-span-7">
          <div class="p-6 sm:p-8 rounded-3xl bg-white border border-stone-200 shadow-sm">
            <h3 class="text-xl font-serif font-bold text-stone-900 mb-2">Send an Enquiry or Prayer Request</h3>
            <p class="text-xs text-stone-500 mb-6">Our office volunteers will get in touch with you shortly.</p>

            <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you. Your message has been received by Thirumarady Devaswom office.');">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-stone-700 mb-1">Your Full Name *</label>
                  <input type="text" required placeholder="Name" class="w-full px-4 py-2.5 rounded-xl border border-stone-300 text-sm focus:outline-none focus:border-amber-500" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-stone-700 mb-1">Mobile Number *</label>
                  <input type="tel" required placeholder="+91 ..." class="w-full px-4 py-2.5 rounded-xl border border-stone-300 text-sm focus:outline-none focus:border-amber-500" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold text-stone-700 mb-1">Email Address *</label>
                <input type="email" required placeholder="email@example.com" class="w-full px-4 py-2.5 rounded-xl border border-stone-300 text-sm focus:outline-none focus:border-amber-500" />
              </div>

              <div>
                <label class="block text-xs font-bold text-stone-700 mb-1">Query Subject *</label>
                <select class="w-full px-4 py-2.5 rounded-xl border border-stone-300 text-sm focus:outline-none focus:border-amber-500">
                  <option>Vazhipadu / Pooja Booking Enquiry</option>
                  <option>Dhanu Utsavam Festival Schedule</option>
                  <option>Annadanam Sponsorship</option>
                  <option>Temple Accommodation / Travel Guidance</option>
                  <option>General Feedback / Other</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold text-stone-700 mb-1">Message or Devotee Prayer *</label>
                <textarea rows="4" required placeholder="Please write your message here..." class="w-full px-4 py-2.5 rounded-xl border border-stone-300 text-sm focus:outline-none focus:border-amber-500"></textarea>
              </div>

              <button type="submit" class="w-full py-3 rounded-xl bg-amber-500 hover:bg-amber-600 text-stone-950 font-bold text-sm transition-colors shadow-sm">
                Submit Enquiry
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
