---
import BaseLayout from "../layouts/BaseLayout.astro";

// Gallery Items
const galleryItems = [
  {
    title: "Thirumarady Sreekovil & Temple Complex",
    malayalam: "ക്ഷേത്ര സമുച്ചയവും ശ്രീകോവിലും",
    category: "complex",
    image: "/uploads/temple/hero-temple.jpg",
    description: "The traditional East-facing circular/rectangular sanctum adorned with copper roof and stone prakarams."
  },
  {
    title: "Evening Deeparadhana with Bronze Lamps",
    malayalam: "സന്ധ്യാ ദീപാരാധന",
    category: "rituals",
    image: "/uploads/temple/deeparadhana-lamps.jpg",
    description: "Thousands of bronze vilakku lamps glowing at twilight during the grand evening Deeparadhana."
  },
  {
    title: "Annual Dhanu Thiruvathira Festival Elephants",
    malayalam: "ആറാട്ട് എഴുന്നള്ളിപ്പ്",
    category: "festivals",
    image: "/uploads/temple/festival-elephants.jpg",
    description: "Caparisoned elephants carrying the gold Kolam of Lord Mahadeva during the holy Utsavam."
  },
  {
    title: "Panchavadyam & Pandi Melam Artists",
    malayalam: "പഞ്ചവാദ്യവും പാണ്ടിമേളവും",
    category: "festivals",
    image: "/uploads/temple/chenda-melam.jpg",
    description: "Renowned percussion masters performing the electrifying Panchavadyam and Thayambaka beats."
  },
  {
    title: "Pooja Offerings & Bilva Leaves",
    malayalam: "പൂജാ ദ്രവ്യങ്ങളും കൂവളമാലയും",
    category: "rituals",
    image: "/uploads/temple/pooja-thali.jpg",
    description: "Sacred offerings prepared for the noon Ucha Pooja and Bilva Patra Archana."
  },
  {
    title: "Ancient Teak Wood Carvings on Mandapam",
    malayalam: "നമസ്കാര മണ്ഡപത്തിലെ ദാരുശില്പം",
    category: "woodwork",
    image: "/uploads/temple/wood-carving.jpg",
    description: "Intricate woodwork depicting mythological episodes from the Ramayana and Shiva Purana."
  },
  {
    title: "Sacred Temple Pond (Ambalakkulam)",
    malayalam: "ക്ഷേത്രക്കുളം (ആറാട്ടുകടവ്)",
    category: "complex",
    image: "/uploads/temple/temple-pond.jpg",
    description: "The tranquil holy waters where Lord Shiva's divine Arattu ritual bath is conducted on Thiruvathira day."
  },
  {
    title: "Traditional Kerala Brass Nilavilakku",
    malayalam: "നിലവിളക്കിന്റെ പ്രഭ",
    category: "rituals",
    image: "/uploads/temple/brass-lamp.jpg",
    description: "Sacred brass oil lamp radiating divine light and auspiciousness throughout the Nalambalam."
  },
  {
    title: "Arattu Procession & Devotees",
    malayalam: "ആറാട്ട് ഘോഷയാത്ര",
    category: "festivals",
    image: "/uploads/temple/arattu-festival.jpg",
    description: "Devotees gathering in devotion as the sacred deity procession moves through Thirumarady village."
  }
];

const videos = [
  {
    title: "Panchavadyam Performance at Thirumarady",
    duration: "12 mins",
    desc: "Vibrant Timila, Maddalam, Edakka, Ilathalam and Kombu ensemble during Utsavam.",
    embedUrl: "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ" // sample placeholder embed
  },
  {
    title: "Deeparadhana Bells & Sacred Conch Resonance",
    duration: "8 mins",
    desc: "Auspicious evening twilight prayers at the East-facing Mahadeva sanctum.",
    embedUrl: "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ"
  }
];
---

<BaseLayout
  title="Photo & Video Gallery | Thirumarady Sri Mahadeva Temple"
  description="High-resolution photos and video clips of Thirumarady Shiva Temple complex, Deeparadhana, Panchavadyam, caparisoned elephants, and past Utsavam highlights."
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-stone-950 via-stone-900 to-stone-950 text-white py-16 sm:py-20 border-b border-amber-600/30 text-center">
    <div class="container">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-semibold mb-3 border border-amber-500/30">
        <span>📸</span>
        <span>ചിത്രശാലയും വീഡിയോകളും</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-serif font-black text-white mb-4">
        Temple Photo & Video Gallery
      </h1>
      <p class="text-stone-300 text-base sm:text-lg max-w-2xl mx-auto font-light">
        Experience the visual majesty of Thirumarady Sri Mahadeva Kshetram, divine Deeparadhana, classical Panchavadyam, and past Utsavam highlights.
      </p>
    </div>
  </section>

  <!-- Gallery Section with Filters & Lightbox -->
  <section class="py-16 sm:py-20 bg-stone-50">
    <div class="container">
      <!-- Filter Tabs -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
        <button class="gallery-filter-btn active px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-amber-600 text-white shadow-sm transition-all" data-category="all">
          All Moments (എല്ലാം)
        </button>
        <button class="gallery-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-white text-stone-700 border border-stone-300 hover:border-amber-500 hover:text-amber-800 transition-all" data-category="complex">
          🏛️ Sreekovil & Complex
        </button>
        <button class="gallery-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-white text-stone-700 border border-stone-300 hover:border-amber-500 hover:text-amber-800 transition-all" data-category="rituals">
          🪔 Deeparadhana & Rituals
        </button>
        <button class="gallery-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-white text-stone-700 border border-stone-300 hover:border-amber-500 hover:text-amber-800 transition-all" data-category="festivals">
          🐘 Utsavam & Panchavadyam
        </button>
        <button class="gallery-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-white text-stone-700 border border-stone-300 hover:border-amber-500 hover:text-amber-800 transition-all" data-category="woodwork">
          🪵 Heritage Woodcraft
        </button>
      </div>

      <!-- Gallery Grid -->
      <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryItems.map((item) => (
          <div
            class="gallery-item group relative overflow-hidden rounded-2xl bg-white border border-stone-200 shadow-sm hover:shadow-xl transition-all cursor-pointer"
            data-category={item.category}
            data-src={item.image}
            data-title={item.title}
            data-desc={item.description}
          >
            <div class="aspect-4/3 overflow-hidden bg-stone-900">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            
            <div class="p-5">
              <h3 class="text-base font-serif font-bold text-stone-900 group-hover:text-amber-800 transition-colors">
                {item.title}
              </h3>
              <p class="text-xs font-malayalam text-stone-500 mb-2">{item.malayalam}</p>
              <p class="text-xs text-stone-600 line-clamp-2">{item.description}</p>
            </div>

            <div class="absolute top-3 right-3 w-8 h-8 rounded-full bg-black/60 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
              🔍
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Video Clips / Melam Showcase -->
  <section class="py-16 sm:py-20 bg-stone-900 text-white">
    <div class="container max-w-5xl">
      <div class="text-center mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Audio Visual Archive</span>
        <h2 class="text-3xl font-serif font-bold text-white mt-1">
          Temple Melam & Cultural Performances
        </h2>
        <p class="text-stone-300 text-sm max-w-2xl mx-auto mt-2 font-light">
          Immerse yourself in traditional Kerala temple percussion, Panchavadyam, Thayambaka, and Utsavam video archives.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {videos.map((vid) => (
          <div class="p-6 rounded-2xl bg-stone-950 border border-amber-500/20 shadow-xl">
            <div class="aspect-video rounded-xl overflow-hidden bg-stone-900 mb-4 border border-stone-800 flex items-center justify-center relative">
              <div class="text-center p-6">
                <span class="text-4xl block mb-2">🥁</span>
                <span class="font-serif font-bold text-amber-300 block">{vid.title}</span>
                <span class="text-xs text-stone-400 mt-1 block">HD Audio & Video Stream</span>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <div>
                <h4 class="text-base font-serif font-bold text-white">{vid.title}</h4>
                <p class="text-xs text-stone-400 mt-0.5">{vid.desc}</p>
              </div>
              <span class="text-xs font-mono font-bold text-amber-400 bg-stone-900 px-2.5 py-1 rounded">
                {vid.duration}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive Lightbox Modal -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden items-center justify-center p-3 sm:p-4">
    <button id="close-lightbox" class="absolute top-3 right-3 sm:top-5 sm:right-5 text-stone-400 hover:text-white text-2xl sm:text-3xl font-bold p-2 z-50">
      ✕
    </button>
    <div class="max-w-4xl w-full text-center">
      <img id="lightbox-img" src="" alt="" class="max-h-[60vh] sm:max-h-[75vh] max-w-full mx-auto rounded-xl sm:rounded-2xl object-contain shadow-2xl mb-3 sm:mb-4 border border-stone-800" />
      <h3 id="lightbox-title" class="text-base sm:text-xl font-serif font-bold text-white px-2"></h3>
      <p id="lightbox-desc" class="text-xs sm:text-sm text-stone-400 mt-1 max-w-2xl mx-auto px-2"></p>
    </div>
  </div>
</BaseLayout>

<script>
  // Filter logic
  const filterBtns = document.querySelectorAll(".gallery-filter-btn");
  const galleryItems = document.querySelectorAll(".gallery-item");

  filterBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      filterBtns.forEach(b => {
        b.classList.remove("active", "bg-amber-600", "text-white");
        b.classList.add("bg-white", "text-stone-700");
      });
      btn.classList.add("active", "bg-amber-600", "text-white");
      btn.classList.remove("bg-white", "text-stone-700");

      const category = btn.getAttribute("data-category");
      galleryItems.forEach(item => {
        if (category === "all" || item.getAttribute("data-category") === category) {
          (item as HTMLElement).style.display = "block";
        } else {
          (item as HTMLElement).style.display = "none";
        }
      });
    });
  });

  // Lightbox logic
  const lightboxModal = document.getElementById("lightbox-modal");
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const lightboxTitle = document.getElementById("lightbox-title");
  const lightboxDesc = document.getElementById("lightbox-desc");
  const closeLightbox = document.getElementById("close-lightbox");

  galleryItems.forEach(item => {
    item.addEventListener("click", () => {
      const src = item.getAttribute("data-src") || "";
      const title = item.getAttribute("data-title") || "";
      const desc = item.getAttribute("data-desc") || "";

      if (lightboxImg) lightboxImg.src = src;
      if (lightboxTitle) lightboxTitle.textContent = title;
      if (lightboxDesc) lightboxDesc.textContent = desc;
      lightboxModal?.classList.remove("hidden");
      lightboxModal?.classList.add("flex");
    });
  });

  function closeLightboxModal() {
    lightboxModal?.classList.add("hidden");
    lightboxModal?.classList.remove("flex");
  }

  closeLightbox?.addEventListener("click", closeLightboxModal);
  lightboxModal?.addEventListener("click", (e) => {
    if (e.target === lightboxModal) {
      closeLightboxModal();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && lightboxModal && !lightboxModal.classList.contains("hidden")) {
      closeLightboxModal();
    }
  });
</script>

