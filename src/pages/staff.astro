---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaffList from "../components/Sections/StaffList.astro";
---

<BaseLayout
  title="Priests & Committee | Thirumarady Sri Mahadeva Temple"
  description="Thanthri from Kidangassery Illam, Chief Melshanthi, Travancore Devaswom Board representatives, and Kshetra Upadeshaka Samithi."
>
  <section class="bg-gradient-to-b from-stone-950 via-stone-900 to-stone-950 text-white py-16 sm:py-20 border-b border-amber-600/30 text-center">
    <div class="container">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-semibold mb-3 border border-amber-500/30">
        <span>👥</span>
        <span>ക്ഷേത്ര ഭാരവാഹികൾ</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-serif font-black text-white mb-4">
        Temple Priests & Administration
      </h1>
      <p class="text-stone-300 text-base sm:text-lg max-w-2xl mx-auto font-light">
        Preserving sacred Tantric rituals and pilgrim welfare with divine dedication.
      </p>
    </div>
  </section>

  <StaffList />
</BaseLayout>
