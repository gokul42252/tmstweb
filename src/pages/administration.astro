---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TEMPLE_INFO } from "../data/templeData";
import Button from "../components/UI/Button.astro";

const committeeMembers = [
  {
    role: "Kshethra Thanthri (ക്ഷേത്ര തന്ത്രി)",
    name: "Brahmasree Kidangassery Illam",
    desc: "Hereditary High Priest lineage guiding all Tantric rites, Utsavam rituals, and sacred consecrations."
  },
  {
    role: "Kshethra Administrative Officer",
    name: "Temple Administrative Cell",
    desc: "Overseeing day-to-day temple administration, assets, accounting, and devotee infrastructure."
  },
  {
    role: "Kshethra Melshanthi (മേൽശാന്തി)",
    name: "Sree Narayanan Namboothiri",
    desc: "Chief Priest performing daily morning Nirmalyam, Vedic poojas, and evening Deeparadhana."
  },
  {
    role: "Kshetra Upadeshaka Samithi President",
    name: "Sri. K. R. Gopalakrishnan Nair",
    desc: "Elected devotee advisory committee president coordinating temple affairs and cultural programs."
  },
  {
    role: "Samithi Secretary",
    name: "Sri. M. N. Radhakrishnan",
    desc: "Managing devotee correspondence, Annadanam arrangements, and voluntary festival seva."
  },
  {
    role: "Devaswom Accounts & Auditor",
    name: "Temple Audit & Accounts Cell",
    desc: "Ensuring complete financial transparency, official donation vouchers, and verified accounts."
  }
];
---

<BaseLayout
  title="Temple Administration & Donations | Thirumarady Sri Mahadeva Temple"
  description="Temple Administration, Kidangassery Thanthri lineage, Kshetra Samithi. Secure Annadanam & Renovation donation portal with instant receipt generation."
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-stone-950 via-stone-900 to-stone-950 text-white py-16 sm:py-20 border-b border-amber-600/30 text-center">
    <div class="container">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-semibold mb-3 border border-amber-500/30">
        <span>🏛️</span>
        <span>ക്ഷേത്ര ഭരണവും അന്നദാന സംഭാവനകളും</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-serif font-black text-white mb-4">
        Administration & Devotee Donations
      </h1>
      <p class="text-stone-300 text-base sm:text-lg max-w-2xl mx-auto font-light">
        Administered under the guidance of the Temple Managing Committee with Tantric authority from Kidangassery Illam. Support sacred Annadanam and heritage temple conservation.
      </p>

      <div class="mt-8 flex justify-center gap-4">
        <a href="#donation" class="btn btn-primary font-bold shadow-md">
          Donate to Annadanam / Renovation ↓
        </a>
      </div>
    </div>
  </section>

  <!-- Administrative Structure & Committee -->
  <section class="py-16 sm:py-20 bg-stone-50 border-b border-stone-200">
    <div class="container max-w-5xl">
      <div class="text-center mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-800">Administrative Governance</span>
        <h2 class="text-3xl font-serif font-bold text-stone-900 mt-1">
          Governing Committee & Thanthri Lineage
        </h2>
        <p class="text-stone-600 text-sm max-w-2xl mx-auto mt-2">
          Administered by the Temple Managing Committee in close collaboration with the hereditary trustees and local Kshetra Upadeshaka Samithi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        {committeeMembers.map((member) => (
          <div class="p-6 rounded-2xl bg-white border border-stone-200 shadow-sm flex flex-col justify-between">
            <div>
              <span class="text-[11px] uppercase font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200 inline-block mb-2">
                {member.role}
              </span>
              <h3 class="text-base sm:text-lg font-serif font-bold text-stone-900 mb-2">
                {member.name}
              </h3>
              <p class="text-xs text-stone-600 leading-relaxed">
                {member.desc}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Thanthri Family Deep-Dive Card -->
      <div id="thanthri" class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-amber-950/80 via-stone-900 to-amber-950/80 border border-amber-500/30 text-white">
        <div class="flex flex-col sm:flex-row items-center gap-6">
          <div class="w-16 h-16 rounded-2xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-3xl flex-shrink-0">
            🔱
          </div>
          <div class="space-y-1 text-center sm:text-left">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Tantric Lineage (തന്ത്രി പരമ്പര)</span>
            <h3 class="text-xl font-serif font-bold text-white">Kidangassery Illam (കിടങ്ങശ്ശേരി ഇല്ലം)</h3>
            <p class="text-xs sm:text-sm text-stone-300 leading-relaxed max-w-3xl">
              The high priests of Kidangassery Illam hold hereditary rights for conducting all high Tantric rites at Thirumarady Shiva Temple. They consecrate the Kodiyettam for the annual Dhanu festival, oversee the Navakam & Kalasam rituals, and preserve the strict sanctity of the Sreekovil.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Secure Annadanam & Temple Renovation Donation Portal -->
  <section id="donation" class="py-16 sm:py-24 bg-stone-900 text-white relative">
    <div class="container max-w-4xl">
      <div class="text-center mb-12">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-semibold mb-2 border border-amber-500/30">
          <span>🍚</span>
          <span>നിത്യ അന്നദാനവും ക്ഷേത്ര പുനരുദ്ധാരണവും</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-white mb-2">
          Secure Temple Donation Portal
        </h2>
        <p class="text-stone-300 text-sm sm:text-base max-w-2xl mx-auto font-light">
          Contribute towards daily Annadanam, heritage woodwork conservation, Veda Patashala, or the Annual Utsavam fund. Receive an instant official 80G tax-exempt receipt.
        </p>
      </div>

      <!-- Donation Form Card -->
      <div class="p-6 sm:p-10 rounded-3xl bg-stone-950 border border-amber-500/30 shadow-2xl">
        <form id="donation-form" class="space-y-6">
          <!-- Cause Selection -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-amber-400 mb-3">
              Select Donation Cause (സംഭാവന ഇനം) *
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <label class="p-4 rounded-xl bg-stone-900 border border-stone-700 flex items-start space-x-3 cursor-pointer hover:border-amber-400">
                <input type="radio" name="donationCause" value="Nitya Annadanam Fund" checked class="mt-1 text-amber-500" />
                <div>
                  <span class="block text-sm font-bold text-white">Nitya Annadanam (നിത്യ അന്നദാനം)</span>
                  <span class="text-xs text-stone-400">Sponsor free holy midday meals for devotees and pilgrims</span>
                </div>
              </label>

              <label class="p-4 rounded-xl bg-stone-900 border border-stone-700 flex items-start space-x-3 cursor-pointer hover:border-amber-400">
                <input type="radio" name="donationCause" value="Heritage Woodwork & Renovation" class="mt-1 text-amber-500" />
                <div>
                  <span class="block text-sm font-bold text-white">Temple Renovation (ക്ഷേത്ര നവീകരണം)</span>
                  <span class="text-xs text-stone-400">Preservation of copper roof, teakwood carvings & murals</span>
                </div>
              </label>

              <label class="p-4 rounded-xl bg-stone-900 border border-stone-700 flex items-start space-x-3 cursor-pointer hover:border-amber-400">
                <input type="radio" name="donationCause" value="Annual Dhanu Utsavam Fund" class="mt-1 text-amber-500" />
                <div>
                  <span class="block text-sm font-bold text-white">Annual Utsavam Fund (ഉത്സവ ഫണ്ട്)</span>
                  <span class="text-xs text-stone-400">Support Panchavadyam, Melam, and Thiruvathira Arattu</span>
                </div>
              </label>

              <label class="p-4 rounded-xl bg-stone-900 border border-stone-700 flex items-start space-x-3 cursor-pointer hover:border-amber-400">
                <input type="radio" name="donationCause" value="Veda & Cultural Trust" class="mt-1 text-amber-500" />
                <div>
                  <span class="block text-sm font-bold text-white">Veda & Cultural Seva (വേദ സംരക്ഷണം)</span>
                  <span class="text-xs text-stone-400">Support traditional Vedic chanting & temple art students</span>
                </div>
              </label>
            </div>
          </div>

          <!-- Preset Amount Buttons & Custom Amount Input -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-amber-400 mb-2">
              Select Amount (തുക തിരഞ്ഞെടുക്കുക) *
            </label>
            <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 mb-3">
              <button type="button" class="amount-btn py-2.5 rounded-xl bg-stone-900 border border-stone-700 text-sm font-bold hover:border-amber-400 hover:text-amber-300" data-amt="251">₹251</button>
              <button type="button" class="amount-btn py-2.5 rounded-xl bg-stone-900 border border-stone-700 text-sm font-bold hover:border-amber-400 hover:text-amber-300" data-amt="501">₹501</button>
              <button type="button" class="amount-btn active py-2.5 rounded-xl bg-amber-500 text-stone-950 font-bold text-sm shadow-md" data-amt="1001">₹1,001</button>
              <button type="button" class="amount-btn py-2.5 rounded-xl bg-stone-900 border border-stone-700 text-sm font-bold hover:border-amber-400 hover:text-amber-300" data-amt="2501">₹2,501</button>
              <button type="button" class="amount-btn py-2.5 rounded-xl bg-stone-900 border border-stone-700 text-sm font-bold hover:border-amber-400 hover:text-amber-300" data-amt="5001">₹5,001</button>
              <button type="button" class="amount-btn py-2.5 rounded-xl bg-stone-900 border border-stone-700 text-sm font-bold hover:border-amber-400 hover:text-amber-300" data-amt="10001">₹10,001</button>
            </div>

            <div class="relative">
              <span class="absolute left-4 top-3 text-stone-400 font-bold">₹</span>
              <input
                type="number"
                id="custom-amount"
                name="amount"
                value="1001"
                min="51"
                required
                placeholder="Or enter custom amount..."
                class="w-full pl-9 pr-4 py-3 rounded-xl bg-stone-900 border border-stone-700 text-white font-mono font-bold text-base focus:outline-none focus:border-amber-400"
              />
            </div>
          </div>

          <!-- Devotee Details -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="donor-name" class="block text-xs font-bold uppercase tracking-wider text-amber-400 mb-2">
                Devotee / Donor Name *
              </label>
              <input
                type="text"
                id="donor-name"
                name="donorName"
                required
                placeholder="e.g., Harikrishnan N."
                class="w-full px-4 py-3 rounded-xl bg-stone-900 border border-stone-700 text-white text-sm focus:outline-none focus:border-amber-400"
              />
            </div>

            <div>
              <label for="pan-number" class="block text-xs font-bold uppercase tracking-wider text-amber-400 mb-2">
                PAN Number (For 80G Tax Exemption)
              </label>
              <input
                type="text"
                id="pan-number"
                name="panNumber"
                placeholder="ABCDE1234F"
                class="w-full px-4 py-3 rounded-xl bg-stone-900 border border-stone-700 text-white text-sm focus:outline-none focus:border-amber-400 uppercase"
              />
            </div>

            <div>
              <label for="donor-phone" class="block text-xs font-bold uppercase tracking-wider text-amber-400 mb-2">
                Mobile Number *
              </label>
              <input
                type="tel"
                id="donor-phone"
                name="donorPhone"
                required
                placeholder="+91 94470 00000"
                class="w-full px-4 py-3 rounded-xl bg-stone-900 border border-stone-700 text-white text-sm focus:outline-none focus:border-amber-400"
              />
            </div>

            <div>
              <label for="donor-email" class="block text-xs font-bold uppercase tracking-wider text-amber-400 mb-2">
                Email Address (For Tax Receipt Voucher) *
              </label>
              <input
                type="email"
                id="donor-email"
                name="donorEmail"
                required
                placeholder="devotee@example.com"
                class="w-full px-4 py-3 rounded-xl bg-stone-900 border border-stone-700 text-white text-sm focus:outline-none focus:border-amber-400"
              />
            </div>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full py-4 rounded-xl bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600 hover:from-amber-500 hover:to-amber-700 text-stone-950 font-serif font-black text-lg tracking-wide uppercase shadow-lg shadow-amber-500/20 transition-all flex items-center justify-center space-x-2"
          >
            <span>🍚 Proceed to UPI Contribution (0% Platform Fee)</span>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Free Dynamic UPI Donation Payment Modal -->
  <div id="don-upi-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-3 sm:p-4 overflow-y-auto">
    <div class="bg-stone-950 text-white border border-amber-500/40 rounded-2xl sm:rounded-3xl max-w-lg w-full p-5 sm:p-7 shadow-2xl relative my-6">
      <button id="close-don-upi-modal-btn" type="button" class="absolute top-4 right-4 sm:top-5 sm:right-5 text-stone-400 hover:text-white text-2xl font-bold p-1">
        ✕
      </button>

      <!-- Modal Header -->
      <div class="text-center pb-3 border-b border-stone-800">
        <div class="inline-flex items-center space-x-1.5 px-3 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-[11px] font-bold mb-2 border border-emerald-500/30">
          <span>⚡ 0% Platform Fee • 100% Directly to Temple Account</span>
        </div>
        <h3 class="text-xl sm:text-2xl font-serif font-black text-white">
          Temple Donation via UPI
        </h3>
        <p class="text-xs text-stone-400 mt-0.5">
          Scan QR code or pay with any UPI App (GPay / PhonePe / Paytm)
        </p>
      </div>

      <!-- Amount Banner -->
      <div class="my-4 p-3.5 rounded-xl bg-gradient-to-r from-amber-950/70 to-stone-900 border border-amber-500/40 text-center">
        <span class="text-[11px] text-stone-400 uppercase tracking-wider block font-bold">Contribution Amount</span>
        <span id="don-upi-modal-amount" class="text-3xl sm:text-4xl font-serif font-black text-amber-300">₹1,001</span>
        <span id="don-upi-modal-cause" class="text-xs text-amber-400 mt-0.5 block font-bold">Nitya Annadanam Fund</span>
        <span id="don-upi-modal-note" class="text-[10px] text-stone-400 mt-0.5 block font-mono">Ref: TM-DON-...</span>
      </div>

      <div class="space-y-4">
        <!-- QR Code Canvas Container -->
        <div class="p-3.5 rounded-2xl bg-stone-900 border border-stone-800 text-center flex flex-col items-center">
          <span class="text-xs font-bold text-amber-400 uppercase tracking-wider mb-2">
            📱 Scan with Any UPI App
          </span>
          <div class="p-2.5 bg-white rounded-xl inline-block shadow-lg">
            <canvas id="don-upi-qr-canvas" class="w-44 h-44 sm:w-48 sm:h-48"></canvas>
          </div>
          <p class="text-[11px] text-stone-400 mt-2">
            Scan using camera or Google Pay / PhonePe / Paytm / BHIM
          </p>
        </div>

        <!-- Mobile Quick-Pay App Buttons -->
        <div>
          <span class="text-[11px] font-bold text-amber-400 uppercase tracking-wider block mb-2 text-center">
            Or Tap to Pay Directly (Mobile Users)
          </span>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
            <a id="don-btn-upi-phonepe" href="#" class="p-2 rounded-xl bg-purple-950/60 border border-purple-500/40 hover:bg-purple-900/60 text-center transition flex flex-col items-center justify-center font-bold text-purple-200">
              <span class="text-base mb-0.5">🟣</span>
              <span>PhonePe</span>
            </a>
            <a id="don-btn-upi-gpay" href="#" class="p-2 rounded-xl bg-blue-950/60 border border-blue-500/40 hover:bg-blue-900/60 text-center transition flex flex-col items-center justify-center font-bold text-blue-200">
              <span class="text-base mb-0.5">🔵</span>
              <span>Google Pay</span>
            </a>
            <a id="don-btn-upi-paytm" href="#" class="p-2 rounded-xl bg-sky-950/60 border border-sky-500/40 hover:bg-sky-900/60 text-center transition flex flex-col items-center justify-center font-bold text-sky-200">
              <span class="text-base mb-0.5">🟦</span>
              <span>Paytm</span>
            </a>
            <a id="don-btn-upi-generic" href="#" class="p-2 rounded-xl bg-amber-950/60 border border-amber-500/40 hover:bg-amber-900/60 text-center transition flex flex-col items-center justify-center font-bold text-amber-200">
              <span class="text-base mb-0.5">🟠</span>
              <span>Any UPI</span>
            </a>
          </div>
        </div>

        <!-- VPA Info & Copy -->
        <div class="p-2.5 rounded-xl bg-stone-900 border border-stone-800 flex items-center justify-between text-xs">
          <div>
            <span class="text-stone-400 block text-[10px] uppercase">Temple UPI ID:</span>
            <span id="don-upi-vpa-display" class="font-mono font-bold text-amber-300">thirumaradytemple@upi</span>
            <span class="text-[10px] text-amber-400/80 block">⚠️ Test Mode (Dummy UPI ID configured)</span>
          </div>
          <button id="don-btn-copy-upi" type="button" class="px-2.5 py-1 rounded bg-stone-800 hover:bg-stone-700 text-stone-200 font-bold text-xs border border-stone-700 transition">
            📋 Copy
          </button>
        </div>

        <!-- Step 2: UTR Reference Submission -->
        <div class="pt-3 border-t border-stone-800 space-y-2.5">
          <label for="don-upi-utr-input" class="block text-xs font-bold uppercase tracking-wider text-amber-400">
            Enter 12-Digit UPI Reference / UTR Number *
          </label>
          <input
            type="text"
            id="don-upi-utr-input"
            maxlength="16"
            placeholder="e.g., 412389123456"
            class="w-full px-4 py-2.5 rounded-xl bg-stone-900 border border-stone-700 text-white font-mono text-sm tracking-wider focus:outline-none focus:border-amber-400 uppercase"
          />
          <p class="text-[10px] text-stone-400">
            💡 Check your payment app receipt history for the 12-digit UTR/Txn number and enter it here to verify your donation.
          </p>

          <button
            type="button"
            id="don-btn-confirm-upi"
            class="w-full py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-stone-950 font-serif font-black text-sm uppercase tracking-wider shadow-lg shadow-emerald-900/30 transition flex items-center justify-center space-x-2"
          >
            <span id="don-btn-confirm-text">✓ Verify Payment & Generate 80G Receipt</span>
          </button>
          <div id="don-upi-error-msg" class="text-xs text-rose-400 text-center hidden"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Donation Receipt Modal -->
  <div id="donation-receipt-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-3 sm:p-4">
    <div class="bg-white text-stone-900 rounded-2xl sm:rounded-3xl max-w-xl w-full p-4 sm:p-6 md:p-8 shadow-2xl relative max-h-[92vh] overflow-y-auto">
      <button id="close-don-modal-btn" class="absolute top-4 sm:top-5 right-4 sm:right-5 text-stone-400 hover:text-stone-800 text-2xl font-bold p-1">
        ✕
      </button>

      <!-- Printable Receipt -->
      <div id="printable-don-receipt" class="print-area space-y-4">
        <div class="text-center pb-4 border-b-2 border-stone-800">
          <div class="w-10 h-10 sm:w-12 sm:h-12 mx-auto rounded-full bg-amber-600 text-white flex items-center justify-center text-lg sm:text-xl mb-1">
            🔱
          </div>
          <h2 class="text-lg sm:text-xl font-serif font-black text-stone-900">
            തിരുമാറാടി ശ്രീ മഹാദേവ ക്ഷേത്രം
          </h2>
          <p class="text-xs font-serif uppercase tracking-wider font-bold text-amber-900">
            Thirumarady Sri Mahadeva Temple Devaswom
          </p>
          <p class="text-[10px] sm:text-[11px] text-stone-500">
            Thirumarady Temple Managing Committee • Reg: TMST/EKM/686662
          </p>
          <div class="inline-block mt-2 px-3 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] sm:text-[11px] font-bold uppercase tracking-wider border border-emerald-300">
            Official Donation Voucher
          </div>
        </div>

        <div class="grid grid-cols-1 xs:grid-cols-2 gap-2 sm:gap-3 text-xs">
          <div class="p-2 sm:p-2.5 rounded bg-stone-50 border border-stone-200">
            <span class="text-stone-400 block text-[10px] uppercase">Voucher ID</span>
            <span id="don-receipt-no" class="font-mono font-bold text-stone-900">TM-DON-2026-5521</span>
          </div>
          <div class="p-2 sm:p-2.5 rounded bg-stone-50 border border-stone-200">
            <span class="text-stone-400 block text-[10px] uppercase">Transaction Date</span>
            <span id="don-receipt-time" class="font-mono font-bold text-stone-900">15 Nov 2026, 01:35 AM</span>
          </div>
          <div class="p-2 sm:p-2.5 rounded bg-stone-50 border border-stone-200">
            <span class="text-stone-400 block text-[10px] uppercase">Donor Name</span>
            <span id="don-receipt-name" class="font-bold text-stone-900">Harikrishnan N.</span>
          </div>
          <div class="p-2 sm:p-2.5 rounded bg-stone-50 border border-stone-200">
            <span class="text-stone-400 block text-[10px] uppercase">PAN Number</span>
            <span id="don-receipt-pan" class="font-bold text-stone-900">ABCDE1234F</span>
          </div>
          <div class="p-2 sm:p-2.5 rounded bg-emerald-50 border border-emerald-300 xs:col-span-2">
            <span class="text-emerald-800 block text-[10px] uppercase font-bold">Payment Method</span>
            <span class="font-mono font-bold text-emerald-900 text-xs">UPI Paid (UTR: <span id="don-receipt-utr-val">-</span>) ✅</span>
          </div>
        </div>

        <div class="p-3 rounded-xl bg-stone-50 border border-stone-200 text-xs">
          <span class="text-stone-500 block text-[10px] uppercase">Dedicated Cause:</span>
          <span id="don-receipt-cause" class="font-bold text-amber-900 text-sm">Nitya Annadanam Fund</span>
        </div>

        <div class="p-3 rounded-xl bg-amber-50 border border-amber-300 flex items-center justify-between">
          <span class="font-serif font-bold text-amber-900 text-sm">Donation Amount Received:</span>
          <span id="don-receipt-amount" class="font-serif font-black text-amber-900 text-xl sm:text-2xl">₹1,001</span>
        </div>

        <div class="pt-4 border-t border-stone-200 flex items-center justify-between text-[10px] sm:text-[11px] text-stone-500 gap-3">
          <p>This donation is eligible for income tax deduction under Section 80G of the Income Tax Act.</p>
          <div class="text-center flex-shrink-0">
            <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full border-2 border-red-700/60 text-red-700 flex items-center justify-center text-[8px] sm:text-[9px] font-bold uppercase tracking-tighter transform rotate-[-8deg] p-1">
              Devaswom Seal
            </div>
          </div>
        </div>
      </div>

      <div class="mt-5 sm:mt-6 flex flex-col xs:flex-row gap-2.5 sm:gap-3 no-print">
        <button
          onclick="window.print()"
          class="flex-1 py-2.5 rounded-xl bg-stone-900 hover:bg-stone-800 text-white font-bold text-xs sm:text-sm transition-colors flex items-center justify-center gap-2 print-include"
        >
          <span>🖨️ Print / Download 80G Receipt</span>
        </button>
        <button
          id="done-don-btn"
          class="px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-stone-950 font-bold text-xs sm:text-sm transition-colors text-center"
        >
          Done
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import QRCode from "qrcode";
  import { supabase } from "../lib/supabaseClient";
  import { TEMPLE_INFO } from "../data/templeData";

  // Amount buttons
  const amountBtns = document.querySelectorAll(".amount-btn");
  const customAmountInput = document.getElementById("custom-amount") as HTMLInputElement;

  amountBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      amountBtns.forEach(b => {
        b.classList.remove("active", "bg-amber-500", "text-stone-950", "shadow-md");
        b.classList.add("bg-stone-900", "text-white");
      });
      btn.classList.add("active", "bg-amber-500", "text-stone-950", "shadow-md");
      btn.classList.remove("bg-stone-900", "text-white");

      const amt = btn.getAttribute("data-amt") || "1001";
      if (customAmountInput) customAmountInput.value = amt;
    });
  });

  if (customAmountInput) {
    customAmountInput.addEventListener("input", () => {
      const currentVal = customAmountInput.value;
      amountBtns.forEach(b => {
        if (b.getAttribute("data-amt") === currentVal) {
          b.classList.add("active", "bg-amber-500", "text-stone-950", "shadow-md");
          b.classList.remove("bg-stone-900", "text-white");
        } else {
          b.classList.remove("active", "bg-amber-500", "text-stone-950", "shadow-md");
          b.classList.add("bg-stone-900", "text-white");
        }
      });
    });
  }

  // Modal elements
  const donUpiModal = document.getElementById("don-upi-modal");
  const closeDonUpiModalBtn = document.getElementById("close-don-upi-modal-btn");
  const donBtnConfirmUpi = document.getElementById("don-btn-confirm-upi");
  const donBtnConfirmText = document.getElementById("don-btn-confirm-text");
  const donUpiUtrInput = document.getElementById("don-upi-utr-input") as HTMLInputElement;
  const donUpiErrorMsg = document.getElementById("don-upi-error-msg");
  const donBtnCopyUpi = document.getElementById("don-btn-copy-upi");

  const donModal = document.getElementById("donation-receipt-modal");
  const closeDonModalBtn = document.getElementById("close-don-modal-btn");
  const doneDonBtn = document.getElementById("done-don-btn");
  const donForm = document.getElementById("donation-form");

  interface PendingDonation {
    cause: string;
    amount: number;
    name: string;
    pan: string;
    phone: string;
    email: string;
    voucherNo: string;
    timeStr: string;
  }

  let currentPendingDonation: PendingDonation | null = null;

  function closeDonationModal() {
    donModal?.classList.add("hidden");
    donModal?.classList.remove("flex");
  }

  function closeDonUpiModal() {
    donUpiModal?.classList.add("hidden");
    donUpiModal?.classList.remove("flex");
  }

  closeDonModalBtn?.addEventListener("click", closeDonationModal);
  doneDonBtn?.addEventListener("click", closeDonationModal);
  closeDonUpiModalBtn?.addEventListener("click", closeDonUpiModal);

  donModal?.addEventListener("click", (e) => {
    if (e.target === donModal) closeDonationModal();
  });

  donUpiModal?.addEventListener("click", (e) => {
    if (e.target === donUpiModal) closeDonUpiModal();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      if (donUpiModal && !donUpiModal.classList.contains("hidden")) closeDonUpiModal();
      if (donModal && !donModal.classList.contains("hidden")) closeDonationModal();
    }
  });

  // Copy UPI ID button
  donBtnCopyUpi?.addEventListener("click", () => {
    const vpa = TEMPLE_INFO.upi?.vpa || "thirumaradytemple@upi";
    navigator.clipboard.writeText(vpa).then(() => {
      donBtnCopyUpi.textContent = "✓ Copied!";
      donBtnCopyUpi.classList.add("bg-emerald-700", "text-white");
      setTimeout(() => {
        donBtnCopyUpi.textContent = "📋 Copy";
        donBtnCopyUpi.classList.remove("bg-emerald-700", "text-white");
      }, 1800);
    }).catch(() => {
      alert("UPI ID: " + vpa);
    });
  });

  // Donation form submit -> opens UPI Checkout modal
  donForm?.addEventListener("submit", (e) => {
    e.preventDefault();

    const cause = (document.querySelector("input[name='donationCause']:checked") as HTMLInputElement)?.value || "Nitya Annadanam";
    const amountVal = parseInt(customAmountInput?.value || "1001", 10);
    const amount = isNaN(amountVal) || amountVal < 51 ? 1001 : amountVal;
    const name = (document.getElementById("donor-name") as HTMLInputElement)?.value.trim() || "Devotee";
    const pan = (document.getElementById("pan-number") as HTMLInputElement)?.value.trim().toUpperCase() || "NOT PROVIDED";
    const phone = (document.getElementById("donor-phone") as HTMLInputElement)?.value.trim() || "";
    const email = (document.getElementById("donor-email") as HTMLInputElement)?.value.trim() || "";

    const now = new Date();
    const datePrefix = now.toISOString().slice(0, 10).replace(/-/g, "");
    const randomSuffix = Math.floor(1000 + Math.random() * 9000);
    const voucherNo = `TM-DON-${datePrefix}-${randomSuffix}`;
    const timeStr = now.toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" });

    currentPendingDonation = {
      cause,
      amount,
      name,
      pan,
      phone,
      email,
      voucherNo,
      timeStr
    };

    // Update UPI modal details
    const amtElem = document.getElementById("don-upi-modal-amount");
    const causeElem = document.getElementById("don-upi-modal-cause");
    const noteElem = document.getElementById("don-upi-modal-note");
    const vpaElem = document.getElementById("don-upi-vpa-display");

    const vpa = TEMPLE_INFO.upi?.vpa || "thirumaradytemple@upi";
    const payeeName = TEMPLE_INFO.upi?.payeeName || "Thirumarady Sri Mahadeva Temple";
    const note = `TMST DONATION ${voucherNo}`;

    if (amtElem) amtElem.textContent = `₹${amount.toLocaleString("en-IN")}`;
    if (causeElem) causeElem.textContent = cause;
    if (noteElem) noteElem.textContent = `Ref: ${voucherNo}`;
    if (vpaElem) vpaElem.textContent = vpa;

    const upiUri = `upi://pay?pa=${vpa}&pn=${encodeURIComponent(payeeName)}&am=${amount.toFixed(2)}&cu=INR&tn=${encodeURIComponent(note)}`;

    // Render dynamic QR code on canvas
    const qrCanvas = document.getElementById("don-upi-qr-canvas") as HTMLCanvasElement;
    if (qrCanvas) {
      QRCode.toCanvas(qrCanvas, upiUri, {
        width: 192,
        margin: 1,
        color: { dark: "#1c1917", light: "#ffffff" }
      }, (err) => {
        if (err) console.error("Donation QR error:", err);
      });
    }

    // Set mobile app links
    const phonepeLink = document.getElementById("don-btn-upi-phonepe") as HTMLAnchorElement;
    const gpayLink = document.getElementById("don-btn-upi-gpay") as HTMLAnchorElement;
    const paytmLink = document.getElementById("don-btn-upi-paytm") as HTMLAnchorElement;
    const genericLink = document.getElementById("don-btn-upi-generic") as HTMLAnchorElement;

    if (phonepeLink) phonepeLink.href = upiUri;
    if (gpayLink) gpayLink.href = upiUri;
    if (paytmLink) paytmLink.href = upiUri;
    if (genericLink) genericLink.href = upiUri;

    // Reset UTR input
    if (donUpiUtrInput) donUpiUtrInput.value = "";
    if (donUpiErrorMsg) {
      donUpiErrorMsg.textContent = "";
      donUpiErrorMsg.classList.add("hidden");
    }

    // Show UPI modal
    donUpiModal?.classList.remove("hidden");
    donUpiModal?.classList.add("flex");
  });

  // Verify UTR & Complete Donation
  donBtnConfirmUpi?.addEventListener("click", async () => {
    if (!currentPendingDonation) {
      alert("No pending donation session found. Please submit the form first.");
      closeDonUpiModal();
      return;
    }

    const utr = donUpiUtrInput?.value.trim();
    if (!utr || utr.length < 6) {
      if (donUpiErrorMsg) {
        donUpiErrorMsg.textContent = "Please enter the valid 12-digit UPI Reference / UTR Number from your payment app.";
        donUpiErrorMsg.classList.remove("hidden");
      }
      donUpiUtrInput?.focus();
      return;
    }

    if (donBtnConfirmUpi) (donBtnConfirmUpi as HTMLButtonElement).disabled = true;
    if (donBtnConfirmText) donBtnConfirmText.textContent = "⏳ Recording Donation to Temple Database...";

    const billId = crypto.randomUUID();
    const today = new Date().toISOString().split("T")[0];
    const billRecord = {
      id: billId,
      bill_number: currentPendingDonation.voucherNo,
      counter_id: "ONLINE",
      billed_by: `Online Donation (UTR: ${utr})`,
      devotee_name: currentPendingDonation.name,
      star_name: "Donation / സംഭാവന",
      gothram: `${currentPendingDonation.cause} (PAN: ${currentPendingDonation.pan})`,
      pooja_date: today,
      payment_mode: "UPI",
      total_amount: currentPendingDonation.amount,
      sync_status: "SYNCED"
    };

    const billItem = {
      id: crypto.randomUUID(),
      bill_id: billId,
      pooja_id: crypto.randomUUID(),
      pooja_name: `Donation: ${currentPendingDonation.cause}`,
      deity_name: "Annadanam / Renovation",
      quantity: 1,
      unit_price: currentPendingDonation.amount,
      subtotal: currentPendingDonation.amount
    };

    try {
      await supabase.from("bills").insert([billRecord]);
      await supabase.from("bill_items").insert([billItem]);
    } catch (err) {
      console.warn("Database fallback:", err);
    }

    // Populate Printable 80G Receipt
    const rNo = document.getElementById("don-receipt-no");
    const rTime = document.getElementById("don-receipt-time");
    const rName = document.getElementById("don-receipt-name");
    const rPan = document.getElementById("don-receipt-pan");
    const rCause = document.getElementById("don-receipt-cause");
    const rAmt = document.getElementById("don-receipt-amount");
    const rUtr = document.getElementById("don-receipt-utr-val");

    if (rNo) rNo.textContent = currentPendingDonation.voucherNo;
    if (rTime) rTime.textContent = currentPendingDonation.timeStr;
    if (rName) rName.textContent = currentPendingDonation.name;
    if (rPan) rPan.textContent = currentPendingDonation.pan;
    if (rCause) rCause.textContent = currentPendingDonation.cause;
    if (rAmt) rAmt.textContent = `₹${currentPendingDonation.amount.toLocaleString("en-IN")}`;
    if (rUtr) rUtr.textContent = utr;

    if (donBtnConfirmUpi) (donBtnConfirmUpi as HTMLButtonElement).disabled = false;
    if (donBtnConfirmText) donBtnConfirmText.textContent = "✓ Verify Payment & Generate 80G Receipt";

    // Close UPI modal, open Receipt modal
    closeDonUpiModal();
    donModal?.classList.remove("hidden");
    donModal?.classList.add("flex");

    // Reset donation form
    (donForm as HTMLFormElement)?.reset();
  });
</script>
