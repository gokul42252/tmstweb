---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/Sections/HeroSection.astro";
import EventList from "../components/Sections/EventList.astro";
import Button from "../components/UI/Button.astro";
import { DARSHAN_SCHEDULE, VAZHIPADU_OFFERINGS, DEITIES_INFO, TEMPLE_INFO } from "../data/templeData";

// Featured offerings
const featuredOfferings = VAZHIPADU_OFFERINGS.filter(v => v.popular).slice(0, 4);
---

<BaseLayout
  title="Thirumarady Sri Mahadeva Temple | തിരുമാറാടി ശിവക്ഷേത്രം, Ernakulam"
  description="Official portal of Thirumarady Sri Mahadeva Temple, an ancient heritage Shiva temple in Ernakulam, Kerala. Darshan timings, Vazhipadu booking, Dhanu Utsavam, and Devaswom info."
>
  <!-- Hero Section with Banner, Live Ticker, Darshan Card & Helpline -->
  <HeroSection />

  <!-- Quick Action Strip -->
  <section class="bg-gradient-to-r from-amber-700 via-amber-800 to-amber-900 text-white py-6 shadow-md border-b-2 border-amber-500">
    <div class="container">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
        <a href="/vazhipadu#booking" class="p-3 rounded-xl bg-black/20 hover:bg-black/35 transition-all border border-amber-400/30 group">
          <span class="text-2xl sm:text-3xl block mb-1 group-hover:scale-110 transition-transform">🪔</span>
          <span class="font-serif font-bold text-sm sm:text-base block text-amber-200">Book Vazhipadu</span>
          <span class="text-[11px] text-stone-300">Online Pooja Booking</span>
        </a>

        <a href="/darshan-timings" class="p-3 rounded-xl bg-black/20 hover:bg-black/35 transition-all border border-amber-400/30 group">
          <span class="text-2xl sm:text-3xl block mb-1 group-hover:scale-110 transition-transform">🕒</span>
          <span class="font-serif font-bold text-sm sm:text-base block text-amber-200">Darshan Timings</span>
          <span class="text-[11px] text-stone-300">Daily Poojas & Deepam</span>
        </a>

        <a href="/festivals" class="p-3 rounded-xl bg-black/20 hover:bg-black/35 transition-all border border-amber-400/30 group">
          <span class="text-2xl sm:text-3xl block mb-1 group-hover:scale-110 transition-transform">🎪</span>
          <span class="font-serif font-bold text-sm sm:text-base block text-amber-200">Dhanu Utsavam</span>
          <span class="text-[11px] text-stone-300">8-Day Annual Festival</span>
        </a>

        <a href="/administration#donation" class="p-3 rounded-xl bg-black/20 hover:bg-black/35 transition-all border border-amber-400/30 group">
          <span class="text-2xl sm:text-3xl block mb-1 group-hover:scale-110 transition-transform">🍚</span>
          <span class="font-serif font-bold text-sm sm:text-base block text-amber-200">Annadanam Seva</span>
          <span class="text-[11px] text-stone-300">Donate with Tax Receipt</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Darshan & Pooja Schedule Section -->
  <section class="py-16 sm:py-20 bg-stone-50">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-900 text-xs font-semibold mb-2">
          <span>🕒</span>
          <span>നിത്യപൂജാ ക്രമം</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-stone-900 mb-3">
          Daily Darshan & Pooja Schedule
        </h2>
        <p class="text-stone-600 text-base sm:text-lg max-w-2xl mx-auto">
          The sanctum opens early morning at 5:00 AM for the sanctifying Nirmalyam darshan, followed by three daily Vedic poojas and evening Deeparadhana.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <!-- Morning Schedule -->
        <div class="p-6 sm:p-8 rounded-2xl bg-white border border-amber-200 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-amber-100">
            <div>
              <span class="text-xs uppercase font-bold text-amber-700 tracking-wider">Morning Darshan</span>
              <h3 class="text-xl sm:text-2xl font-serif font-bold text-stone-900">പ്രഭാത ദർശനം</h3>
            </div>
            <span class="px-3 py-1 rounded-full bg-amber-100 text-amber-900 font-mono font-bold text-xs">
              05:00 AM – 10:30 AM
            </span>
          </div>

          <div class="space-y-4">
            <div class="flex items-start justify-between pb-3 border-b border-stone-100">
              <div>
                <h4 class="font-bold text-stone-800 text-sm sm:text-base">05:00 AM – Nada Thurakkal</h4>
                <p class="text-xs text-stone-500">Awakening of Sanctum & Nirmalyam Darshan</p>
              </div>
              <span class="text-xs font-malayalam font-semibold text-amber-800">നിർമ്മാല്യം</span>
            </div>

            <div class="flex items-start justify-between pb-3 border-b border-stone-100">
              <div>
                <h4 class="font-bold text-stone-800 text-sm sm:text-base">05:30 AM – Jaladhara & Abhishekam</h4>
                <p class="text-xs text-stone-500">Continuous cool water bath and Sankhabhishekam</p>
              </div>
              <span class="text-xs font-malayalam font-semibold text-amber-800">ജലധാര</span>
            </div>

            <div class="flex items-start justify-between pb-3 border-b border-stone-100">
              <div>
                <h4 class="font-bold text-stone-800 text-sm sm:text-base">06:15 AM – Usha Pooja</h4>
                <p class="text-xs text-stone-500">Morning floral archana and sweet nivedyam</p>
              </div>
              <span class="text-xs font-malayalam font-semibold text-amber-800">ഉഷഃപൂജ</span>
            </div>

            <div class="flex items-start justify-between pb-3 border-b border-stone-100">
              <div>
                <h4 class="font-bold text-stone-800 text-sm sm:text-base">07:30 AM – Pantheeradi Pooja</h4>
                <p class="text-xs text-stone-500">Solar alignment ritual for family harmony</p>
              </div>
              <span class="text-xs font-malayalam font-semibold text-amber-800">പന്തീരടി</span>
            </div>

            <div class="flex items-start justify-between">
              <div>
                <h4 class="font-bold text-stone-800 text-sm sm:text-base">10:00 AM – Ucha Pooja & Nada Closing</h4>
                <p class="text-xs text-stone-500">Grand noon pooja; doors close at 10:30 AM</p>
              </div>
              <span class="text-xs font-malayalam font-semibold text-amber-800">ഉച്ചപ്പൂജ</span>
            </div>
          </div>
        </div>

        <!-- Evening Schedule -->
        <div class="p-6 sm:p-8 rounded-2xl bg-white border border-amber-200 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-amber-100">
            <div>
              <span class="text-xs uppercase font-bold text-amber-700 tracking-wider">Evening Darshan</span>
              <h3 class="text-xl sm:text-2xl font-serif font-bold text-stone-900">സന്ധ്യാ ദർശനം</h3>
            </div>
            <span class="px-3 py-1 rounded-full bg-amber-100 text-amber-900 font-mono font-bold text-xs">
              05:00 PM – 08:00 PM
            </span>
          </div>

          <div class="space-y-4">
            <div class="flex items-start justify-between pb-3 border-b border-stone-100">
              <div>
                <h4 class="font-bold text-stone-800 text-sm sm:text-base">05:00 PM – Evening Opening</h4>
                <p class="text-xs text-stone-500">Sanctum opens for twilight pradakshinam</p>
              </div>
              <span class="text-xs font-malayalam font-semibold text-amber-800">നടതുറക്കൽ</span>
            </div>

            <div class="flex items-start justify-between pb-3 border-b border-stone-100 bg-amber-50/60 p-2.5 rounded-lg border border-amber-200/50">
              <div>
                <h4 class="font-bold text-amber-900 text-sm sm:text-base">06:30 PM – Deeparadhana ✨</h4>
                <p class="text-xs text-amber-800">Illumination of lamps with bells, conch & melam</p>
              </div>
              <span class="text-xs font-malayalam font-bold text-red-700">ദീപാരാധന</span>
            </div>

            <div class="flex items-start justify-between pb-3 border-b border-stone-100">
              <div>
                <h4 class="font-bold text-stone-800 text-sm sm:text-base">07:30 PM – Athazha Pooja</h4>
                <p class="text-xs text-stone-500">Night offering and sweet appam/payasam</p>
              </div>
              <span class="text-xs font-malayalam font-semibold text-amber-800">അത്താഴപ്പൂജ</span>
            </div>

            <div class="flex items-start justify-between">
              <div>
                <h4 class="font-bold text-stone-800 text-sm sm:text-base">08:00 PM – Thrikkuka & Nada Adaikkal</h4>
                <p class="text-xs text-stone-500">Sacred frankincense offering and night closing</p>
              </div>
              <span class="text-xs font-malayalam font-semibold text-amber-800">തൃപ്പുക</span>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-stone-200 text-center">
            <a href="/darshan-timings" class="text-amber-800 hover:text-amber-900 font-bold text-xs uppercase tracking-wider inline-flex items-center gap-1">
              <span>View Special Festival & Pradosham Hours</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Presiding Deities & Spiritual Order Section -->
  <section class="py-16 sm:py-20 bg-stone-900 text-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-semibold mb-2 border border-amber-500/30">
          <span>🕉️</span>
          <span>പ്രതിഷ്ഠകളും ഉപദേവതകളും</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-white mb-3">
          Presiding Deity & Holy Upa Devatas
        </h2>
        <p class="text-stone-300 text-base sm:text-lg max-w-2xl mx-auto font-light">
          Worship Lord Shiva in his East-facing cosmic sanctity, followed by sub-deities Lord Ganapathy, Lord Ayyappan, and Lord Subrahmanian.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {DEITIES_INFO.slice(0, 4).map((deity, idx) => (
          <div class="p-6 rounded-2xl bg-stone-950/80 border border-amber-500/20 hover:border-amber-400/50 transition-all flex flex-col justify-between group">
            <div>
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 text-2xl mb-4 group-hover:scale-110 transition-transform">
                {idx === 0 ? "🔱" : idx === 1 ? "🐘" : idx === 2 ? "🏹" : "🦚"}
              </div>
              <span class="text-[11px] uppercase tracking-wider text-amber-400 font-bold block">{deity.direction}</span>
              <h3 class="text-xl font-serif font-bold text-white mb-1 group-hover:text-amber-300 transition-colors">
                {deity.name.split("(")[0]}
              </h3>
              <p class="text-xs font-malayalam text-amber-200/80 mb-3">{deity.malayalam}</p>
              <p class="text-xs text-stone-400 leading-relaxed line-clamp-3 mb-4">
                {deity.description}
              </p>
            </div>

            <div class="pt-4 border-t border-stone-800/80 text-xs text-stone-300">
              <span class="text-amber-400 font-semibold block mb-1">Key Offerings:</span>
              <span class="text-stone-400">{deity.keyOfferings.slice(0, 2).join(", ")}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Proper Circumambulation (Pradakshina) Alert Banner -->
      <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-red-950/70 via-stone-950 to-red-950/70 border border-red-500/40 max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="space-y-1 text-center sm:text-left">
          <div class="inline-flex items-center space-x-1.5 text-xs font-bold text-red-400 uppercase tracking-wider">
            <span>⚠️</span>
            <span>Important Tantric Rule</span>
          </div>
          <h4 class="text-lg sm:text-xl font-serif font-bold text-white">
            Do NOT Cross the Somassuthram Spout (സോമസൂത്രം)
          </h4>
          <p class="text-xs sm:text-sm text-stone-300 max-w-xl">
            In Kerala Shiva temples, full 360-degree circumambulation is prohibited. Devotees must reverse direction upon reaching the northern holy water channel.
          </p>
        </div>
        <Button href="/deities#pradakshina" variant="primary" size="sm" class="flex-shrink-0 font-bold whitespace-nowrap">
          View Pradakshina Guide →
        </Button>
      </div>
    </div>
  </section>

  <!-- Featured Vazhipadu Offerings & Booking CTA -->
  <section class="py-16 sm:py-20 bg-stone-50 border-b border-stone-200">
    <div class="container">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-900 text-xs font-semibold mb-2">
            <span>🥥</span>
            <span>വിശേഷാൽ വഴിപാടുകൾ</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-serif font-bold text-stone-900">
            Sacred Offerings & Remote Booking
          </h2>
          <p class="text-stone-600 text-base max-w-xl mt-2 font-light">
            Sponsor traditional Vedic homams, pushpanjalis, and abhishekam in your birth star (Nakshatra) from anywhere in the world.
          </p>
        </div>

        <div class="mt-4 md:mt-0">
          <Button href="/vazhipadu" variant="outline" class="font-bold border-amber-500/50 text-amber-900 hover:bg-amber-100">
            View All Offerings & Rates →
          </Button>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredOfferings.map((offering) => (
          <div class="p-6 rounded-2xl bg-white border border-stone-200/90 shadow-sm hover:shadow-lg hover:border-amber-400 transition-all flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs uppercase font-bold text-amber-700 tracking-wider">
                  {offering.deityName.split("(")[0]}
                </span>
                <span class="text-base font-serif font-extrabold text-amber-700 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200">
                  ₹{offering.rate}
                </span>
              </div>

              <h3 class="text-lg font-serif font-bold text-stone-900 group-hover:text-amber-800 transition-colors mb-0.5">
                {offering.name}
              </h3>
              <p class="text-xs font-malayalam font-bold text-stone-500 mb-2">{offering.malayalam}</p>

              <p class="text-xs text-stone-600 leading-relaxed mb-3">
                {offering.description}
              </p>

              <div class="p-2.5 rounded-lg bg-amber-50/70 border border-amber-100 text-[11px] text-amber-900 leading-tight">
                <strong>Spiritual Benefit:</strong> {offering.significance}
              </div>
            </div>

            <div class="mt-5 pt-4 border-t border-stone-100">
              <a
                href={`/vazhipadu#booking?id=${offering.id}`}
                class="w-full inline-flex items-center justify-center py-2 px-3 text-xs font-bold text-stone-900 bg-amber-400 hover:bg-amber-500 rounded-lg transition-colors shadow-sm"
              >
                Book This Offering
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Upcoming Festivals & Utsavam Section -->
  <EventList count={3} />

  <!-- Sthala Purana & Architectural Heritage Section -->
  <section class="py-16 sm:py-20 bg-stone-900 text-white relative overflow-hidden">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Visuals (5 cols) -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border-2 border-amber-500/30">
            <img 
              src="/uploads/temple/wood-carving.jpg" 
              alt="Ancient Kerala Woodwork and Architecture" 
              class="w-full h-80 sm:h-96 object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-stone-950/80 backdrop-blur-md border border-amber-500/30">
              <span class="text-xs uppercase font-bold text-amber-400">Architectural Heritage</span>
              <p class="text-xs text-stone-300 mt-0.5">Traditional Vatta Sreekovil with copper-plated roof & teakwood Ramayana carvings.</p>
            </div>
          </div>
        </div>

        <!-- Text (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-semibold border border-amber-500/30">
            <span>📜</span>
            <span>സ്ഥലപുരാണവും പൈതൃകവും</span>
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-white leading-tight">
            Centuries of Sacred Antiquity & Heritage Woodcraft
          </h2>

          <p class="text-stone-300 text-sm sm:text-base leading-relaxed font-light">
            Thirumarady Sri Mahadeva Temple holds a revered place in the spiritual landscape of central Kerala. Originating in an ancient epoch where Vedic sages meditated on the banks of holy streams, the temple was nurtured for centuries by four traditional Ooralan Brahmin families: <strong>Kattampilly, Kizhekkillam, Edayattuppilly, and Kanjirappilly Illams</strong>, alongside the sacred serpent sanctuary of <strong>Edaprakavu</strong>.
          </p>

          <p class="text-stone-300 text-sm sm:text-base leading-relaxed font-light">
            In 1965, the sacred administration was entrusted to the <strong>Travancore Devaswom Board</strong>, while the Tantric rituals remain consecrated under the hereditary guardianship of the <strong>Kidangassery Illam</strong>.
          </p>

          <div class="flex flex-wrap gap-4 pt-2">
            <Button href="/heritage" variant="primary" size="md" class="font-bold">
              Read Complete Sthala Puranam →
            </Button>
            <Button href="/gallery" variant="outline" size="md" class="border-stone-700 text-stone-200 hover:text-stone-950">
              View Temple Gallery
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Dress Code & Temple Etiquette Quick Banner -->
  <section class="py-12 bg-amber-500/10 border-b border-amber-500/30">
    <div class="container">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 max-w-5xl mx-auto">
        <div class="flex items-center space-x-4 text-left">
          <div class="w-12 h-12 rounded-full bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-2xl flex-shrink-0">
            🙏
          </div>
          <div>
            <h3 class="text-lg font-serif font-bold text-stone-900">Visiting Thirumarady Temple?</h3>
            <p class="text-xs sm:text-sm text-stone-600">
              Traditional Kerala attire is mandatory (Mundu for men with upper body bare inside Nalambalam; Saree / Set Mundu for women). Photography inside the inner courtyard is strictly prohibited.
            </p>
          </div>
        </div>

        <a
          href="/etiquette"
          class="px-5 py-2.5 rounded-lg bg-stone-900 hover:bg-stone-800 text-white text-xs sm:text-sm font-bold flex-shrink-0 shadow-md transition-colors"
        >
          Devotee Guidelines →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
